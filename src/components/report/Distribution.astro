---
interface DistItem {
  label: string;
  n: number;
  share: number;
}

interface Props {
  name: string;
  isBenchmark?: boolean;
  n: number;
  topBox: number;
  topTwo: number;
  distribution: DistItem[];
}

const { name, isBenchmark, n, topBox, topTwo, distribution } = Astro.props;

function pct(v: number) {
  return `${Math.round(v * 100)}%`;
}
---

<article class="distribution">
  <header>
    <h3>{name}{isBenchmark ? ' · benchmark' : ''}</h3>
    <p>n = {n} · top box {pct(topBox)} · top two {pct(topTwo)}</p>
  </header>
  <ul>
    {distribution.map((d) => (
      <li>
        <span class="label">{d.label}</span>
        <span class="track" aria-hidden="true">
          <span class="fill" style={`width: ${Math.max(d.share * 100, 1)}%`}></span>
        </span>
        <span class="share">{pct(d.share)} · {d.n}</span>
      </li>
    ))}
  </ul>
</article>

<style>
  .distribution {
    border: 1px solid var(--warm-light);
    padding: 1.35rem 1.5rem;
    background: var(--cream);
  }
  header {
    margin-bottom: 1.15rem;
  }
  h3 {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
  }
  header p {
    font-size: 0.8rem;
    color: var(--ink-lighter);
  }
  li {
    display: grid;
    grid-template-columns: 9rem 1fr 5.5rem;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.55rem;
  }
  .label { font-size: 0.85rem; color: var(--ink-light); }
  .track {
    height: 8px;
    background: var(--cream-dark);
    border-radius: 2px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--sage);
    border-radius: 2px;
  }
  .share {
    font-size: 0.78rem;
    color: var(--ink-lighter);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  @media (max-width: 600px) {
    li { grid-template-columns: 1fr; gap: 0.25rem; margin-bottom: 0.85rem; }
    .share { text-align: left; }
  }
</style>

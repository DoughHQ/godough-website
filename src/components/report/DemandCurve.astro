---
interface Point {
  price: number;
  share_would_pay_gte: number;
}

interface Props {
  points: Point[];
  anchor: number;
}

const { points, anchor } = Astro.props;

const w = 420;
const h = 180;
const pad = { t: 16, r: 16, b: 36, l: 40 };
const innerW = w - pad.l - pad.r;
const innerH = h - pad.t - pad.b;
const minP = Math.min(...points.map((p) => p.price));
const maxP = Math.max(...points.map((p) => p.price));

function x(price: number) {
  return pad.l + ((price - minP) / (maxP - minP || 1)) * innerW;
}
function y(share: number) {
  return pad.t + (1 - share) * innerH;
}

const path = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(p.price).toFixed(1)} ${y(p.share_would_pay_gte).toFixed(1)}`)
  .join(' ');
---

<figure class="demand">
  <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Stated willingness to pay by price">
    <line x1={pad.l} y1={pad.t} x2={pad.l} y2={h - pad.b} stroke="#E2D5C3" />
    <line x1={pad.l} y1={h - pad.b} x2={w - pad.r} y2={h - pad.b} stroke="#E2D5C3" />
    <line
      x1={x(anchor)}
      y1={pad.t}
      x2={x(anchor)}
      y2={h - pad.b}
      stroke="#B8906A"
      stroke-dasharray="4 4"
    />
    <path d={path} fill="none" stroke="#3e6b4a" stroke-width="2.5" />
    {points.map((p) => (
      <circle cx={x(p.price)} cy={y(p.share_would_pay_gte)} r="3.5" fill="#1c2620" />
    ))}
    <text x={pad.l - 8} y={pad.t + 4} text-anchor="end" font-size="10" fill="#A89D90">100%</text>
    <text x={pad.l - 8} y={h - pad.b} text-anchor="end" font-size="10" fill="#A89D90">0%</text>
    {points.map((p) => (
      <text x={x(p.price)} y={h - 12} text-anchor="middle" font-size="10" fill="#A89D90">
        ${p.price.toFixed(2)}
      </text>
    ))}
  </svg>
  <figcaption>Dashed line is your price anchor (${anchor.toFixed(2)}). Share willing to pay at or above each price.</figcaption>
</figure>

<style>
  .demand {
    margin: 1rem 0 0;
    max-width: 480px;
  }
  svg {
    width: 100%;
    height: auto;
    background: var(--cream-mid);
    border: 1px solid var(--warm-light);
  }
  figcaption {
    margin-top: 0.65rem;
    font-size: 0.78rem;
    color: var(--ink-lighter);
    line-height: 1.5;
  }
</style>

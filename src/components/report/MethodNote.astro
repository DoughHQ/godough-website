---
interface Props {
  method: {
    confidence: string;
    result_rule: string;
    head_to_head: string;
    liking: string;
    price: string;
  };
}

const { method } = Astro.props;
const rows = [
  { key: 'Confidence', text: method.confidence },
  { key: 'Result rule', text: method.result_rule },
  { key: 'Head to head', text: method.head_to_head },
  { key: 'Liking', text: method.liking },
  { key: 'Price', text: method.price },
];
---

<section class="method-note">
  <h2>Method, as written in the report</h2>
  <dl>
    {rows.map((r) => (
      <div>
        <dt>{r.key}</dt>
        <dd>{r.text}</dd>
      </div>
    ))}
  </dl>
  <p class="link"><a href="/method">Read the full method →</a></p>
</section>

<style>
  .method-note {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--field);
    color: var(--cream);
  }
  h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  div {
    padding: 1rem 0;
    border-top: 1px solid rgba(250, 248, 243, 0.12);
  }
  dt {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.4rem;
  }
  dd {
    font-size: 0.95rem;
    color: rgba(250, 248, 243, 0.78);
    line-height: 1.65;
    max-width: 60ch;
  }
  .link {
    margin-top: 1.5rem;
  }
  .link a {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm);
    text-decoration: none;
  }
  .link a:hover { color: var(--cream); }
</style>

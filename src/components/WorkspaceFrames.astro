---
const PORTAL = 'https://brands.godough.co'

const frames = [
  {
    label: 'Dashboard',
    src: `${PORTAL}/marketing/workspace/home`,
    title: 'Brand home in the Dough portal',
    eager: true,
  },
  {
    label: 'Concept study',
    src: `${PORTAL}/marketing/workspace/concept`,
    title: 'Concept study report in the Dough portal',
    eager: false,
  },
  {
    label: 'Report verdict',
    src: `${PORTAL}/marketing/workspace/report`,
    title: 'Concept test report in the Dough portal',
    eager: false,
  },
]
---

<div class="frames">
  {frames.map((frame) => (
    <figure class="frame">
      <figcaption>{frame.label}</figcaption>
      <div class="chrome">
        <div class="chrome-bar" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="url">{frame.src.replace('https://', '')}</span>
        </div>
        <iframe
          class="portal-frame"
          src={frame.src}
          title={frame.title}
          loading={frame.eager ? 'eager' : 'lazy'}
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </figure>
  ))}
</div>

<p class="live-note">
  These are live views from <a href="https://brands.godough.co">brands.godough.co</a>, rendered with
  simulated fixture data — the same components brands see after access.
</p>

<style>
  .frames {
    display: grid;
    gap: 2rem;
  }
  figcaption {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }
  .chrome {
    border: 1px solid var(--warm-light);
    border-radius: 12px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 18px 48px rgba(24, 21, 15, 0.08);
  }
  .chrome-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    background: var(--cream-mid);
    border-bottom: 1px solid var(--warm-light);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warm-light);
  }
  .url {
    margin-left: 0.75rem;
    font-size: 0.7rem;
    color: var(--ink-lighter);
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .portal-frame {
    display: block;
    width: 100%;
    height: min(88vh, 960px);
    border: 0;
    background: var(--cream);
  }
  .live-note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--ink-lighter);
    line-height: 1.55;
    max-width: 52ch;
  }
  .live-note a {
    color: var(--warm);
    text-decoration: none;
  }
  .live-note a:hover {
    text-decoration: underline;
  }
</style>

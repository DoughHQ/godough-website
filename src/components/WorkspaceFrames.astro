---
/** Illustrated portal frames — stand in for live screenshots until captured. */
---

<div class="frames">
  <figure class="frame">
    <figcaption>Dashboard</figcaption>
    <div class="chrome" aria-hidden="true">
      <div class="chrome-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">brands.godough.co</span>
      </div>
      <div class="chrome-body dash">
        <aside>
          <span class="nav-item on">Home</span>
          <span class="nav-item">Products</span>
          <span class="nav-item">Studies</span>
          <span class="nav-item">Reports</span>
        </aside>
        <main>
          <p class="kicker">Your brand</p>
          <p class="title">Keel Still</p>
          <div class="cards">
            <div class="card"><span>42</span><em>Claimed SKUs</em></div>
            <div class="card"><span>3</span><em>Active studies</em></div>
            <div class="card"><span>1</span><em>Report ready</em></div>
          </div>
        </main>
      </div>
    </div>
  </figure>

  <figure class="frame">
    <figcaption>Concept study</figcaption>
    <div class="chrome" aria-hidden="true">
      <div class="chrome-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">brands.godough.co/studies/concept</span>
      </div>
      <div class="chrome-body study">
        <p class="kicker">Concept test</p>
        <p class="title">New label vs current pack</p>
        <div class="shelf">
          <div class="pack">New label</div>
          <div class="vs">vs</div>
          <div class="pack muted">Current pack</div>
        </div>
        <div class="bars">
          <div><span>Head to head</span><i>50%</i></div>
          <div><span>Price at $2.49</span><i>50%</i></div>
          <div><span>Liking</span><i>Off</i></div>
        </div>
      </div>
    </div>
  </figure>

  <figure class="frame">
    <figcaption>Report verdict</figcaption>
    <div class="chrome" aria-hidden="true">
      <div class="chrome-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">brands.godough.co/studies/…/report</span>
      </div>
      <div class="chrome-body report">
        <p class="kicker">Verdict</p>
        <p class="title bad">Not cleared</p>
        <div class="rows">
          <div><span>Head to head</span><b class="ok">Cleared</b></div>
          <div><span>Price</span><b class="no">Not cleared</b></div>
          <div><span>Liking</span><b class="na">Not tested</b></div>
        </div>
      </div>
    </div>
  </figure>
</div>

<style>
  .frames {
    display: grid;
    gap: 2rem;
  }
  figcaption {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }
  .chrome {
    border: 1px solid var(--warm-light);
    border-radius: 12px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 18px 48px rgba(24, 21, 15, 0.08);
  }
  .chrome-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    background: var(--cream-mid);
    border-bottom: 1px solid var(--warm-light);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warm-light);
  }
  .url {
    margin-left: 0.75rem;
    font-size: 0.7rem;
    color: var(--ink-lighter);
    letter-spacing: 0.02em;
  }
  .chrome-body {
    padding: 1.5rem;
    min-height: 200px;
  }
  .dash {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-right: 1rem;
    border-right: 1px solid var(--warm-light);
  }
  .nav-item {
    font-size: 0.78rem;
    color: var(--ink-lighter);
  }
  .nav-item.on { color: var(--ink); font-weight: 500; }
  .kicker {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.4rem;
  }
  .title {
    font-family: var(--serif);
    font-size: 1.65rem;
    font-weight: 400;
    margin-bottom: 1.25rem;
  }
  .title.bad { color: #8b3a2f; }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .card {
    background: var(--cream-mid);
    padding: 1rem;
    border: 1px solid var(--warm-light);
  }
  .card span {
    display: block;
    font-family: var(--serif);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .card em {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--ink-lighter);
  }
  .shelf {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .pack {
    flex: 1;
    height: 100px;
    border-radius: 10px;
    background: var(--field);
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }
  .pack.muted { background: var(--field-mid); opacity: 0.7; }
  .vs {
    font-family: var(--serif);
    font-style: italic;
    color: var(--warm);
  }
  .bars > div,
  .rows > div {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-top: 1px solid var(--warm-light);
    font-size: 0.9rem;
  }
  .bars i { font-style: normal; color: var(--ink-light); font-variant-numeric: tabular-nums; }
  .ok { color: var(--sage); font-weight: 500; }
  .no { color: #8b3a2f; font-weight: 500; }
  .na { color: var(--ink-lighter); font-weight: 400; }

  @media (max-width: 600px) {
    .dash { grid-template-columns: 1fr; }
    aside { flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid var(--warm-light); padding-bottom: 0.75rem; }
    .cards { grid-template-columns: 1fr; }
  }
</style>

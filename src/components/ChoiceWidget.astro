---
interface Props {
  footNote?: string;
}

const {
  footNote = 'Illustrative matchup. Same layout as the app. Dough is not those brands.',
} = Astro.props;
---

<div class="mech" id="choice-widget" data-choice>
  <p class="mech-beat-label">1 · Choose</p>
  <div class="split-battle" role="group" aria-label="Which would you rather have?">
    <div class="split-battle-top">
      <span class="split-battle-eyebrow">Still water</span>
      <div class="split-battle-pips" aria-hidden="true">
        <span class="split-battle-pip is-on"></span>
        <span class="split-battle-pip is-on"></span>
        <span class="split-battle-pip"></span>
        <span class="split-battle-pip"></span>
        <span class="split-battle-pip"></span>
      </div>
    </div>
    <p class="split-battle-question">Which would you rather have?</p>
    <div class="split-battle-arena">
      <button type="button" class="split-battle-half is-chosen" data-side="a" id="mech-a" aria-pressed="true">
        <span class="split-battle-portrait">
          <img src="/demo/product-a.svg" alt="" width="120" height="160" />
        </span>
        <span class="split-battle-name">Mountain Water</span>
        <span class="split-battle-brand">Liquid Death</span>
      </button>
      <button type="button" class="split-battle-half is-not" data-side="b" id="mech-b" aria-pressed="false">
        <span class="split-battle-portrait">
          <img src="/demo/product-b.svg" alt="" width="120" height="160" />
        </span>
        <span class="split-battle-name">Smartwater</span>
        <span class="split-battle-brand">Glacéau</span>
      </button>
      <span class="split-battle-divider" aria-hidden="true"></span>
      <span class="split-battle-vs" aria-hidden="true">vs</span>
    </div>
  </div>
  <p class="mech-hint" id="mech-hint">Pick the one you'd rather have</p>

  <div class="mech-arrow" aria-hidden="true">↓</div>

  <p class="mech-beat-label">2 · Capture</p>
  <div class="mech-capture">
    <p class="mech-capture-line" id="mech-capture">
      Shopper chose <strong>Mountain Water</strong> over <strong>Smartwater</strong> · Still water
    </p>
  </div>

  <div class="mech-arrow" aria-hidden="true">↓</div>

  <p class="mech-beat-label">3 · Derive</p>
  <div class="mech-derive">
    <div class="mech-derive-title" id="mech-derive-title">Mountain Water</div>
    <div class="mech-derive-meta" id="mech-derive-meta">Winning more of these head-to-heads in Still water</div>
    <p class="mech-derive-note">
      Brand insight only shows where enough shoppers have made choices. One pick is a fact. A pattern becomes a standing.
    </p>
  </div>

  <p class="mech-foot">{footNote}</p>
</div>

<style>
  .mech {
    margin-top: 2.75rem;
    max-width: 480px;
  }

  .mech-beat-label {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.85rem;
  }

  .split-battle {
    position: relative;
    background: #1c3a24;
    border-radius: 20px;
    overflow: hidden;
    color: #f2efe6;
    box-shadow: 0 18px 48px rgba(24, 21, 15, 0.18);
    user-select: none;
  }

  .split-battle-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px 0;
  }

  .split-battle-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(201, 214, 204, 0.78);
  }

  .split-battle-pips {
    display: flex;
    gap: 4px;
    width: 72px;
  }

  .split-battle-pip {
    flex: 1;
    height: 2.5px;
    border-radius: 2px;
    background: rgba(157, 184, 166, 0.26);
  }
  .split-battle-pip.is-on { background: #e4e0d4; }

  .split-battle-question {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    color: #f2efe6;
    padding: 18px 16px 8px;
    margin: 0 auto;
    white-space: nowrap;
  }

  .split-battle-arena {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 280px;
    padding: 12px 16px 0;
  }

  .split-battle-half {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 8px 16px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--sans);
    color: inherit;
    transition: opacity 0.18s, transform 0.18s;
  }

  .split-battle-half:focus-visible {
    outline: 2px solid rgba(157, 184, 166, 0.55);
    outline-offset: 2px;
    border-radius: 12px;
  }

  .split-battle-half.is-chosen { transform: scale(1.015); }
  .split-battle-half.is-not { opacity: 0.52; }

  .split-battle-portrait {
    width: 100%;
    aspect-ratio: 0.72;
    max-height: 200px;
    background: #151e18;
    border: 1px solid rgba(157, 184, 166, 0.24);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .split-battle-half.is-chosen .split-battle-portrait {
    box-shadow: 0 0 0 1.5px rgba(157, 184, 166, 0.36);
  }

  .split-battle-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }

  .split-battle-name {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    color: #f2efe6;
    text-align: center;
    min-height: 36px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 4px;
  }

  .split-battle-brand {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    letter-spacing: 0.25px;
    color: rgba(201, 214, 204, 0.7);
    text-align: center;
  }

  .split-battle-divider {
    position: absolute;
    top: 24px;
    bottom: 88px;
    left: 50%;
    width: 1px;
    background: rgba(157, 184, 166, 0.28);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .split-battle-vs {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(18, 30, 22, 0.88);
    border: 1.5px solid rgba(157, 184, 166, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 13px;
    color: #f2efe6;
    pointer-events: none;
    z-index: 2;
  }

  .mech-hint {
    text-align: center;
    margin-top: 0.85rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-lighter);
  }

  .mech-arrow {
    display: flex;
    justify-content: center;
    padding: 0.85rem 0;
    color: var(--warm);
    font-size: 1.1rem;
    line-height: 1;
  }

  .mech-capture,
  .mech-derive {
    border: 1px solid var(--warm-light);
    background: var(--cream);
    padding: 1.15rem 1.35rem;
    border-radius: 12px;
  }

  .mech-capture-line {
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--ink);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .mech-capture-line :global(strong) { font-weight: 500; }

  .mech-derive-title {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .mech-derive-meta {
    font-size: 0.88rem;
    color: var(--sage);
    font-weight: 500;
    margin-bottom: 0.55rem;
  }

  .mech-derive-note {
    font-size: 0.8rem;
    color: var(--ink-lighter);
    line-height: 1.5;
    max-width: 48ch;
  }

  .mech-foot {
    margin-top: 1.25rem;
    font-size: 0.78rem;
    color: var(--ink-lighter);
    line-height: 1.5;
    max-width: 440px;
  }

  @media (max-width: 600px) {
    .mech { max-width: 100%; }
    .split-battle-question {
      padding-left: 10px;
      padding-right: 10px;
      font-size: 1.05rem;
      white-space: normal;
    }
  }
</style>

<script>
  function initChoice(root: Element) {
    const products = {
      a: { brand: 'Liquid Death', name: 'Mountain Water', category: 'Still water' },
      b: { brand: 'Glacéau', name: 'Smartwater', category: 'Still water' },
    };
    const cardA = root.querySelector<HTMLButtonElement>('[data-side="a"]');
    const cardB = root.querySelector<HTMLButtonElement>('[data-side="b"]');
    const capture = root.querySelector('#mech-capture');
    const deriveTitle = root.querySelector('#mech-derive-title');
    const deriveMeta = root.querySelector('#mech-derive-meta');
    const hint = root.querySelector('#mech-hint');
    if (!cardA || !cardB || !capture) return;

    function choose(side: 'a' | 'b') {
      const won = products[side];
      const lost = products[side === 'a' ? 'b' : 'a'];
      cardA!.classList.toggle('is-chosen', side === 'a');
      cardA!.classList.toggle('is-not', side !== 'a');
      cardB!.classList.toggle('is-chosen', side === 'b');
      cardB!.classList.toggle('is-not', side !== 'b');
      cardA!.setAttribute('aria-pressed', side === 'a' ? 'true' : 'false');
      cardB!.setAttribute('aria-pressed', side === 'b' ? 'true' : 'false');
      capture!.innerHTML =
        'Shopper chose <strong>' +
        won.name +
        '</strong> over <strong>' +
        lost.name +
        '</strong> · ' +
        won.category;
      if (deriveTitle) deriveTitle.textContent = won.name;
      if (deriveMeta) deriveMeta.textContent = 'Winning more of these head-to-heads in ' + won.category;
      if (hint) hint.textContent = "That's a captured preference";
    }

    cardA.addEventListener('click', () => choose('a'));
    cardB.addEventListener('click', () => choose('b'));
  }

  document.querySelectorAll('[data-choice]').forEach(initChoice);
</script>

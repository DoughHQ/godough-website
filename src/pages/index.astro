---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChoiceWidget from '../components/ChoiceWidget.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Dough — Real grocery choices. Verdicts that can say no."
  description="New York shoppers pick between real grocery products. Brands see standings where the choices are thick enough — then concept and box studies against that same world, with reports that can fail."
  navTheme="field"
  current="/"
>
  <header class="home-hero">
    <div class="home-hero-copy">
      <p class="home-brand">Dough</p>
      <h1 class="home-headline">
        Real grocery choices. A standing — or a verdict that can kill the design.
      </h1>
      <p class="home-sub">
        Not surveys. Not soft decks. New York shoppers pick between real SKUs. Brands use those picks to compete, test a pack, or put a box in a kitchen — same preference world, end to end.
      </p>
      <div class="hero-actions home-actions">
        <a class="btn-primary" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost" href="/report/example">See a report that said no</a>
      </div>
    </div>

    <a class="home-outcome" href="/report/example">
      <div class="home-outcome-top">
        <span class="home-outcome-sim">Simulated</span>
        <span class="home-outcome-brand">Keel</span>
      </div>
      <p class="home-outcome-product">Keel Lemon Water</p>
      <p class="home-outcome-meta">Flavored water · New York shoppers</p>

      <div class="home-outcome-row">
        <div class="home-outcome-block">
          <span class="home-outcome-label">Standing</span>
          <span class="home-outcome-value">Winning more</span>
          <span class="home-outcome-detail">Head-to-heads vs the shelf — only where choices are thick enough</span>
        </div>
        <div class="home-outcome-block is-fail">
          <span class="home-outcome-label">Concept study</span>
          <span class="home-outcome-value">Not cleared</span>
          <span class="home-outcome-detail">New label beat current pack. Price at $2.49 did not.</span>
        </div>
      </div>

      <div class="home-outcome-chain" aria-hidden="true">
        <span>Pick</span>
        <span class="home-outcome-chain-sep">→</span>
        <span>Standing</span>
        <span class="home-outcome-chain-sep">→</span>
        <span>Verdict</span>
      </div>
      <span class="home-outcome-go">Read the worked example →</span>
    </a>
  </header>

  <section class="proof-strip" aria-label="At a glance">
    <div class="proof-item">
      <span class="proof-n">600k+</span>
      <span class="proof-l">Real SKUs to battle — not made-up stimuli</span>
    </div>
    <div class="proof-item">
      <span class="proof-n">700+</span>
      <span class="proof-l">Categories with a living shelf</span>
    </div>
    <div class="proof-item">
      <span class="proof-n">NYC</span>
      <span class="proof-l">Shoppers who already choose in-app</span>
    </div>
    <div class="proof-item">
      <span class="proof-n">Can say no</span>
      <span class="proof-l">Bars you set. Verdicts that can fail.</span>
    </div>
  </section>

  <section class="why-close" id="why" aria-labelledby="why-headline">
    <div class="why-close-copy">
      <p class="why-label">Why brands switch</p>
      <h2 id="why-headline" class="why-headline">
        You don’t need another study that finds a reason to ship.
      </h2>
      <p class="why-sub">
        You need New York shoppers picking between real products — and a report that can tell you to stop.
      </p>
    </div>

    <div class="why-story" aria-label="How Dough is different">
      <!-- Beat 1: Pick -->
      <article class="why-beat">
        <div class="why-viz" aria-hidden="true">
          <div class="viz-pick">
            <div class="viz-score is-out">
              <span class="viz-score-n">7.2</span>
              <span class="viz-score-l">Likelihood to buy</span>
            </div>
            <div class="viz-pick-arena">
              <div class="viz-pick-half is-won">
                <img src="/demo/product-a.svg" alt="" width="72" height="144" />
                <span>Keel</span>
              </div>
              <span class="viz-pick-vs">vs</span>
              <div class="viz-pick-half">
                <img src="/demo/product-b.svg" alt="" width="72" height="144" />
                <span>Rivermark</span>
              </div>
            </div>
            <p class="viz-pick-cap">One pick. Real SKUs.</p>
          </div>
        </div>
        <div class="why-beat-copy">
          <span class="why-beat-n">01</span>
          <span class="why-fear">“We got a 7.2 likelihood to buy.”</span>
          <h3>A pick, not a score.</h3>
          <p>Two real grocery products. One choice. Enough picks become a standing — only where the signal is thick enough.</p>
        </div>
      </article>

      <!-- Beat 2: Shelf -->
      <article class="why-beat is-flip">
        <div class="why-viz" aria-hidden="true">
          <div class="viz-shelf">
            <div class="viz-shelf-top">
              <span>Living catalog</span>
              <span class="viz-shelf-count">600k+</span>
            </div>
            <div class="viz-shelf-grid">
              <div class="viz-sku is-live"><b></b><em>Keel Lemon</em></div>
              <div class="viz-sku is-live"><b></b><em>Rivermark</em></div>
              <div class="viz-sku"><b></b><em>Northveil</em></div>
              <div class="viz-sku is-live"><b></b><em>Keel 12oz</em></div>
              <div class="viz-sku"><b></b><em>—</em></div>
              <div class="viz-sku is-dim"><b></b><em>—</em></div>
            </div>
            <div class="viz-shelf-foot">
              <span class="viz-pill is-on">Flavored water · standing</span>
              <span class="viz-pill">Still water · building</span>
            </div>
          </div>
        </div>
        <div class="why-beat-copy">
          <span class="why-beat-n">02</span>
          <span class="why-fear">“The panel never saw our bottle.”</span>
          <h3>Your shelf, not a mock.</h3>
          <p>Shoppers battle the living catalog — then concept and box against that same world. No handoff to strangers.</p>
        </div>
      </article>

      <!-- Beat 3: Verdict -->
      <article class="why-beat">
        <div class="why-viz" aria-hidden="true">
          <a class="viz-verdict" href="/report/example">
            <div class="viz-verdict-top">
              <span class="viz-sim">Simulated</span>
              <span class="viz-verdict-badge">Not cleared</span>
            </div>
            <p class="viz-verdict-product">Keel Lemon Water</p>
            <p class="viz-verdict-meta">New label vs current pack</p>
            <div class="viz-bars">
              <div class="viz-bar">
                <span>Head to head</span>
                <div class="viz-bar-track"><i style="width: 65%"></i></div>
                <em class="is-ok">Cleared</em>
              </div>
              <div class="viz-bar">
                <span>Price · $2.49</span>
                <div class="viz-bar-track is-bad"><i style="width: 38%"></i></div>
                <em class="is-bad">Missed</em>
              </div>
            </div>
            <span class="viz-verdict-go">One miss fails the study →</span>
          </a>
        </div>
        <div class="why-beat-copy">
          <span class="why-beat-n">03</span>
          <span class="why-fear">“The deck always finds a reason to ship.”</span>
          <h3>We’ll tell you not to print it.</h3>
          <p>You set the bars before anyone starts. Cleared only when the whole 95% interval clears. Four verdicts — including not cleared.</p>
          <div class="why-verdict-chips" aria-label="Four verdicts">
            <span class="verdict-chip cleared">Cleared</span>
            <span class="verdict-chip not_cleared">Not cleared</span>
            <span class="verdict-chip too_close_to_call">Too close to call</span>
            <span class="verdict-chip not_enough_responses">Not enough</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <p class="section-label">When brands call</p>
    <h2 class="section-headline sell">Three decisions. One preference world.</h2>
    <ul class="decision-list">
      <li>
        <a href="/product/compete">
          <strong>Are we losing on the shelf?</strong>
          <span>Claim your SKUs. See where New York shoppers already pick — and where the signal isn’t thick enough yet.</span>
          <em>Compete →</em>
        </a>
      </li>
      <li>
        <a href="/product/concept-tests">
          <strong>Should we print this pack?</strong>
          <span>New label vs current — or one competitor. You set the bars. The report can say no.</span>
          <em>Concept tests →</em>
        </a>
      </li>
      <li>
        <a href="/product/box-studies">
          <strong>Would they come back after tasting?</strong>
          <span>Ship to Dough shoppers who’ve rated products like yours. Preference after use — then buy-again.</span>
          <em>Box studies →</em>
        </a>
      </li>
    </ul>
  </section>

  <section class="section field" id="world">
    <p class="section-label">Same world end to end</p>
    <h2 class="section-headline sell">Compete. Concept. Box. No panel handoff.</h2>
    <p class="section-body">
      Everyday battles become standings. A concept asks on a screen. A box asks after they’ve used it at home. Same New York shoppers. Same catalog.
    </p>
    <ol class="world-chain">
      <li>
        <span class="world-n">01</span>
        <strong>Compete</strong>
        <span>Standing from ordinary picks</span>
      </li>
      <li>
        <span class="world-n">02</span>
        <strong>Concept</strong>
        <span>Bars frozen before anyone starts</span>
      </li>
      <li>
        <span class="world-n">03</span>
        <strong>Box</strong>
        <span>Use at home, then choose again</span>
      </li>
    </ol>
  </section>

  <section class="section" id="how">
    <p class="section-label">How preference is made</p>
    <h2 class="section-headline sell">Two products. One pick. Enough picks become a standing.</h2>
    <p class="section-body">
      Not browsing. Not a survey. Try the same choice shoppers make — then see what a brand receives.
    </p>
    <div class="how-grid">
      <ChoiceWidget />
      <aside class="how-aside">
        <ol class="how-steps">
          <li>
            <strong>Choose</strong>
            <span>A shopper picks the one they would rather have.</span>
          </li>
          <li>
            <strong>Capture</strong>
            <span>That preference is recorded against real products in a real category.</span>
          </li>
          <li>
            <strong>Derive</strong>
            <span>Where enough people have chosen, brands see standings, concept results, and box follow-ups.</span>
          </li>
        </ol>
        <div class="how-links">
          <a href="/method">Method →</a>
          <a href="/shoppers">Who answers →</a>
          <a href="/product/workspace">The workspace →</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand
    headline="Find your brand and request access."
    body="A person reviews every request and writes back. No self-serve checkout on this site."
  />
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: 92vh;
    min-height: 92dvh;
    padding: 7.5rem var(--page-pad) clamp(3rem, 6vh, 4.5rem);
    position: relative;
    overflow: hidden;
    color: var(--cream);
    background:
      radial-gradient(ellipse 80% 65% at 85% 20%, rgba(62, 107, 74, 0.42), transparent 55%),
      radial-gradient(ellipse 45% 40% at 5% 90%, rgba(184, 144, 106, 0.14), transparent 50%),
      linear-gradient(165deg, #1a221c 0%, var(--field) 42%, #0e1210 100%);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .home-hero-copy,
  .home-outcome {
    position: relative;
    z-index: 1;
  }

  .home-brand {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 7vw, 5.5rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--cream);
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(16px);
    animation: homeUp 0.75s var(--ease) 0.05s forwards;
  }

  .home-headline {
    font-family: var(--sans);
    font-size: clamp(1.55rem, 2.9vw, 2.25rem);
    font-weight: 600;
    font-style: normal;
    line-height: 1.18;
    letter-spacing: -0.025em;
    max-width: 20ch;
    color: var(--cream);
    margin-bottom: 1.15rem;
    opacity: 0;
    transform: translateY(16px);
    animation: homeUp 0.75s var(--ease) 0.14s forwards;
  }

  .home-sub {
    font-size: clamp(0.98rem, 1.35vw, 1.08rem);
    font-weight: 300;
    color: rgba(250, 248, 243, 0.78);
    max-width: 38ch;
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(14px);
    animation: homeUp 0.7s var(--ease) 0.22s forwards;
  }

  .home-actions {
    opacity: 0;
    transform: translateY(14px);
    animation: homeUp 0.7s var(--ease) 0.3s forwards;
  }

  /* Hero outcome card — brand deliverable, not just the mechanic */
  .home-outcome {
    display: block;
    text-decoration: none;
    color: var(--cream);
    background:
      radial-gradient(ellipse 70% 60% at 100% 0%, rgba(62, 107, 74, 0.35), transparent 55%),
      rgba(250, 248, 243, 0.05);
    border: 1px solid rgba(250, 248, 243, 0.14);
    border-radius: 18px;
    padding: 1.65rem 1.75rem 1.5rem;
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(24px) scale(0.985);
    animation: homeProduct 0.9s var(--ease) 0.28s forwards;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .home-outcome:hover {
    transform: translateY(-3px) scale(1);
    border-color: rgba(250, 248, 243, 0.28);
  }

  .home-outcome-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
  }

  .home-outcome-sim {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    border: 1px solid rgba(184, 144, 106, 0.45);
    padding: 0.28rem 0.55rem;
    border-radius: 2px;
  }

  .home-outcome-brand {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.72);
  }

  .home-outcome-product {
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.4vw, 1.95rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.3rem;
  }

  .home-outcome-meta {
    font-size: 0.78rem;
    color: rgba(250, 248, 243, 0.72);
    margin: 0 0 1.35rem;
  }

  .home-outcome-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 1.15rem;
  }

  .home-outcome-block {
    background: rgba(250, 248, 243, 0.06);
    border: 1px solid rgba(250, 248, 243, 0.1);
    border-radius: 12px;
    padding: 1rem 0.95rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .home-outcome-block.is-fail {
    border-color: rgba(240, 180, 168, 0.28);
    background: rgba(240, 180, 168, 0.08);
  }

  .home-outcome-label {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.65);
    margin-bottom: 0.25rem;
  }

  .home-outcome-value {
    font-family: var(--serif);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #b8d4c0;
  }

  .home-outcome-block.is-fail .home-outcome-value {
    color: #f0b4a8;
  }

  .home-outcome-detail {
    font-size: 0.72rem;
    color: rgba(250, 248, 243, 0.72);
    line-height: 1.4;
    margin-top: 0.35rem;
  }

  .home-outcome-chain {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 0 1.1rem;
    border-top: 1px solid rgba(250, 248, 243, 0.12);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.7);
  }

  .home-outcome-chain-sep {
    color: var(--warm);
  }

  .home-outcome-go {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e0c4a0;
    font-weight: 500;
  }

  .home-outcome:hover .home-outcome-go {
    color: #f0d8b8;
  }

  @keyframes homeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes homeProduct {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 0 var(--page-pad);
    background: var(--field-mid);
    border-bottom: 1px solid rgba(250, 248, 243, 0.08);
  }

  .proof-item {
    padding: 1.65rem 1.25rem;
    border-right: 1px solid rgba(250, 248, 243, 0.08);
    color: var(--cream);
  }
  .proof-item:last-child { border-right: none; }

  .proof-n {
    display: block;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.45rem;
  }

  .proof-l {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.78);
    line-height: 1.4;
    max-width: 18ch;
  }

  .section-headline.sell {
    font-family: var(--sans);
    font-weight: 600;
    font-style: normal;
    max-width: 22ch;
    letter-spacing: -0.025em;
  }

  /* Why brands switch — visual story */
  .why-close {
    padding: clamp(3.5rem, 7vw, 5.5rem) var(--page-pad) clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(ellipse 70% 55% at 90% 10%, rgba(62, 107, 74, 0.38), transparent 55%),
      radial-gradient(ellipse 40% 35% at 0% 100%, rgba(184, 144, 106, 0.12), transparent 50%),
      linear-gradient(165deg, #1a221c 0%, var(--field) 45%, #0e1210 100%);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .why-close::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    opacity: 0.35;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .why-close-copy,
  .why-story {
    position: relative;
    z-index: 1;
  }

  .why-label {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.15rem;
  }

  .why-headline {
    font-family: var(--sans);
    font-size: clamp(1.75rem, 3.6vw, 2.65rem);
    font-weight: 600;
    font-style: normal;
    letter-spacing: -0.025em;
    line-height: 1.15;
    max-width: 18ch;
    color: var(--cream);
    margin-bottom: 1.15rem;
  }

  .why-sub {
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    font-weight: 300;
    line-height: 1.55;
    color: rgba(250, 248, 243, 0.82);
    max-width: 42ch;
    margin-bottom: 3rem;
  }

  .why-story {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .why-beat {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .why-beat.is-flip .why-viz {
    order: 2;
  }

  .why-beat.is-flip .why-beat-copy {
    order: 1;
  }

  .why-beat-n {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.85rem;
  }

  .why-fear {
    display: block;
    font-size: 0.9rem;
    font-style: italic;
    color: rgba(250, 248, 243, 0.48);
    margin-bottom: 0.55rem;
  }

  .why-beat-copy h3 {
    font-family: var(--sans);
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--cream);
    margin: 0 0 0.85rem;
  }

  .why-beat-copy p {
    font-size: 1.02rem;
    line-height: 1.55;
    color: rgba(250, 248, 243, 0.78);
    max-width: 36ch;
    margin: 0;
  }

  .why-viz {
    min-width: 0;
  }

  /* —— Viz: pick —— */
  .viz-pick {
    position: relative;
    background: rgba(250, 248, 243, 0.04);
    border: 1px solid rgba(250, 248, 243, 0.12);
    border-radius: 16px;
    padding: 1.5rem 1.35rem 1.25rem;
    overflow: hidden;
  }

  .viz-score {
    position: absolute;
    top: 1rem;
    right: 1rem;

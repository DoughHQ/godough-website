---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../data/site';
---

<BaseLayout
  title="Delivery Partners — Dough"
  description="Dough builds approved, preference-mapped grocery carts. For delivery partners."
  crumbs={[{ label: 'Delivery partners' }]}
>
  <header class="page-hero">
    <p class="hero-eyebrow">For delivery partners</p>
    <h1 class="hero-headline">The most intentional grocery orders on the <em>internet.</em></h1>
    <p class="hero-sub">
      Dough builds approved, preference-mapped carts of fresh and packaged food. Dough never touches a product.
    </p>
  </header>

  <section class="section">
    <p class="section-label">How it works</p>
    <h2 class="section-headline">Four steps. Nothing <em>complicated.</em></h2>
    <div class="access-list">
      <div class="access-row reveal">
        <span class="access-num">01</span>
        <div>
          <h3 class="access-title">Users declare their preferences</h3>
          <p class="access-copy">Dough users compare fresh and packaged food products in head-to-head preference battles. Two options. One honest choice.</p>
        </div>
      </div>
      <div class="access-row reveal">
        <span class="access-num">02</span>
        <div>
          <h3 class="access-title">Dough maps what they want</h3>
          <p class="access-copy">Every choice sharpens the preference map across 600,000+ indexed fresh and packaged food products.</p>
        </div>
      </div>
      <div class="access-row reveal">
        <span class="access-num">03</span>
        <div>
          <h3 class="access-title">Dough builds the cart</h3>
          <p class="access-copy">Dough curates a personalized grocery cart. The user reviews it. The user approves it.</p>
        </div>
      </div>
      <div class="access-row reveal">
        <span class="access-num">04</span>
        <div>
          <h3 class="access-title">Dough sends it. You fulfill it.</h3>
          <p class="access-copy">Dough transmits the approved cart. Dough never holds inventory. The delivery partner delivers it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section field">
    <p class="section-label">The data behind every cart</p>
    <h2 class="section-headline">Declared preference. Not inferred. Not purchase <em>history.</em></h2>
    <p class="section-body">
      Most purchase intent data is backward-looking. Dough captures something different: when a user chooses between two products they genuinely know, that choice is the demand signal. Every cart is downstream of those choices, confirmed before transmission.
    </p>
    <div class="truth-grid" style="border-top-color: rgba(250,248,243,0.12); margin-top: 2.5rem;">
      <div class="truth-item" style="border-right-color: rgba(250,248,243,0.12);">
        <div class="truth-n" style="color: var(--cream);">600<em>k+</em></div>
        <p class="truth-l" style="color: rgba(250,248,243,0.65);">Products indexed</p>
      </div>
      <div class="truth-item" style="border-right-color: rgba(250,248,243,0.12);">
        <div class="truth-n" style="color: var(--cream);">700<em>+</em></div>
        <p class="truth-l" style="color: rgba(250,248,243,0.65);">Categories mapped</p>
      </div>
      <div class="truth-item">
        <div class="truth-n" style="color: var(--cream);">Pre-<em>approved</em></div>
        <p class="truth-l" style="color: rgba(250,248,243,0.65);">Every cart</p>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="section-label">Where Dough is headed</p>
    <h2 class="section-headline">New York first. Then <em>everywhere.</em></h2>
    <p class="section-body">
      Dough is evaluating grocery delivery partnerships for its initial market launch and national expansion. Dough handles the preference intelligence layer. The delivery partner handles fulfillment. Clean separation.
    </p>
    <div class="hero-actions" style="margin-top: 2rem;">
      <a class="btn-primary on-cream" href={`mailto:${CONTACT_EMAIL}`}>
        {CONTACT_EMAIL} <span class="arr" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

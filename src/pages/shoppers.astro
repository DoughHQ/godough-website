---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import '../styles/offer-product.css';
---

<BaseLayout
  title="Who answers — Dough"
  description="Shoppers in New York, in the Dough app, who already scan and rank products in category. That taste history is how we know who fits a study — then they choose."
  current="/shoppers"
  crumbs={[{ label: 'Shoppers' }]}
>
  <header class="shop-hero">
    <div class="shop-hero-copy">
      <p class="shop-eyebrow">Shoppers</p>
      <h1 class="shop-headline">New York shoppers who already rank.</h1>
      <p class="shop-sub">
        Not a cold panel. They scan and battle products they already buy — build a personal ranking in your category — then answer your concept or open your box as the next pick in that same act.
      </p>
      <div class="hero-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="/method">How verdicts work</a>
      </div>
    </div>

    <a class="shop-hero-card" href="#ahead" aria-label="Simulated shopper ranking — why this panel is different">
      <div class="shop-hero-card-top">
        <span class="shop-hero-sim">Simulated</span>
        <span class="shop-hero-loc">New York shopper</span>
      </div>
      <p class="shop-hero-card-title">Her flavored water</p>
      <p class="shop-hero-card-meta">My list · 24 battles · ordinary app picks</p>

      <div class="shop-rank">
        <p class="shop-rank-champ-label">Champion</p>
        <div class="shop-rank-row is-champ">
          <span class="shop-rank-n" aria-hidden="true">1</span>
          <span class="shop-rank-thumb" aria-hidden="true">
            <img src="/demo/product-a.svg" alt="" width="40" height="40" />
          </span>
          <span class="shop-rank-body">
            <span class="shop-rank-name">Keel Lemon Water</span>
            <span class="shop-rank-meta">14 battles</span>
          </span>
          <span class="shop-rank-tried">Tried</span>
        </div>

        <p class="shop-rank-also">Also ranked</p>
        <ul class="shop-rank-list">
          <li class="shop-rank-row">
            <span class="shop-rank-n" aria-hidden="true">2</span>
            <span class="shop-rank-thumb is-b" aria-hidden="true">
              <img src="/demo/product-b.svg" alt="" width="40" height="40" />
            </span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Rivermark Sparkling</span>
              <span class="shop-rank-meta">11 battles</span>
            </span>
            <span class="shop-rank-tried">Tried</span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n" aria-hidden="true">3</span>
            <span class="shop-rank-thumb is-letter" aria-hidden="true" data-letter="N"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Northveil Citrus</span>
              <span class="shop-rank-meta">9 battles</span>
            </span>
            <span class="shop-rank-tried">Tried</span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n" aria-hidden="true">4</span>
            <span class="shop-rank-thumb is-letter is-mute" aria-hidden="true" data-letter="H"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Harbor Clear</span>
              <span class="shop-rank-meta">6 battles</span>
            </span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n" aria-hidden="true">5</span>
            <span class="shop-rank-thumb is-letter is-atlas" aria-hidden="true" data-letter="A"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Atlas Lime</span>
              <span class="shop-rank-meta">4 battles</span>
            </span>
            <span class="shop-rank-tried">Tried</span>
          </li>
        </ul>
      </div>

      <div class="shop-hero-foot">
        <span><b>Fit</b> — ranked in category before your study</span>
        <span><b>Then</b> — concept or box as the next pick</span>
      </div>
      <span class="shop-hero-go">Why this panel is different ↓</span>
    </a>
  </header>

  <!-- How they answer -->
  <section class="shop-section" id="how">
    <p class="section-label">How they answer</p>
    <h2 class="shop-h2">Two products. One pick. The same act every time.</h2>
    <p class="shop-lead">
      They scan a product, battle two things in a category they know, and pick. Enough picks become a personal ranking. A study is not a different kind of person — it is that same choice, with your packs or your box as the pair.
    </p>

    <div class="shop-beat">
      <div class="shop-viz" aria-hidden="true">
        <div class="shop-pick">
          <div class="shop-pick-arena">
            <div class="shop-pick-half is-won">
              <img src="/demo/product-a.svg" alt="" width="72" height="144" />
              <span>Keel</span>
            </div>
            <span class="shop-pick-vs">vs</span>
            <div class="shop-pick-half">
              <img src="/demo/product-b.svg" alt="" width="72" height="144" />
              <span>Rivermark</span>
            </div>
          </div>
          <p class="shop-pick-cap">Illustrative · fictional products · same layout as the app</p>
        </div>
      </div>
      <ol class="shop-steps">
        <li>
          <span class="shop-step-n">01</span>
          <strong>Scan</strong>
          <span>A real SKU from the living catalog</span>
        </li>
        <li>
          <span class="shop-step-n">02</span>
          <strong>Rank</strong>
          <span>Battles stack into their list in category</span>
        </li>
        <li>
          <span class="shop-step-n">03</span>
          <strong>Choose</strong>
          <span>Your concept or box as the next pick</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Head start -->
  <section class="shop-section mid" id="ahead">
    <p class="section-label">Why this panel is different</p>
    <h2 class="shop-h2">They already have a ranking in your category.</h2>
    <p class="shop-lead">
      Everyday scans and battles build a personal list — products they’ve tried, ordered by how they actually choose. Fit for a study comes from that history. Then they pick your pair or open your box.
    </p>

    <div class="ahead-grid">
      <article class="ahead-card">
        <p class="ahead-kicker">Concept</p>
        <h3>Same ranked shoppers. Your pair on a screen.</h3>
        <p>People who already battle the category see your design against the pack you have to beat — and pick.</p>
      </article>
      <article class="ahead-card is-box">
        <p class="ahead-kicker">Box</p>
        <h3>Already rated products like yours.</h3>
        <p>We ship to Dough shoppers who’ve already chosen in similar categories. Preference after use — then whether they’d come back.</p>
      </article>
    </div>
  </section>

  <!-- Where -->
  <section class="shop-section" id="where">
    <p class="section-label">Where</p>
    <h2 class="shop-h2">New York — and we say so.</h2>
    <div class="where-card">
      <div class="where-stat">
        <span class="where-n">NYC</span>
        <span class="where-l">First panel</span>
      </div>
      <p class="where-body">
        They are in the city. When the panel grows past New York, the report will say where the answers came from. Until then this site says New York — because that is the truth.
      </p>
    </div>
  </section>

  <!-- Enough -->
  <section class="shop-section mid" id="enough">
    <p class="section-label">When enough is enough</p>
    <h2 class="shop-h2">A handful of taps is not a result.</h2>
    <div class="enough-grid">
      <div class="enough-col">
        <p class="enough-eyebrow">Concept bar</p>
        <p class="enough-body">Under ten completed answers reads <span class="verdict-chip not_enough_responses">Not enough responses</span> — not a pass, not a fail.</p>
      </div>
      <div class="enough-col">
        <p class="enough-eyebrow">Standing</p>
        <p class="enough-body">Everyday competition on a claimed product waits until the choices are thick enough to be a pattern.</p>
      </div>
    </div>
    <p class="shop-note">
      Same floor as the report. <a href="/method">Method →</a>
    </p>
  </section>

  <!-- Same world -->
  <section class="shop-section" id="world">
    <p class="section-label">One preference world</p>
    <h2 class="shop-h2">Brands and shoppers share the picks. Not the homepage.</h2>
    <div class="world-grid">
      <div class="world-col">
        <p class="world-eyebrow">Shoppers</p>
        <p class="world-body">Shape your plate — scan, battle, choose honestly.</p>
        <a href="/app">The shopper app →</a>
      </div>
      <div class="world-col is-brand">
        <p class="world-eyebrow">Brands</p>
        <p class="world-body">Standings, concept, and box — against that same preference.</p>
        <a href="/">For brands →</a>
      </div>
    </div>
    <nav class="shop-related" aria-label="Continue">
      <a href="/method">Method</a>
      <a href="/report/example">Example report</a>
      <a href="/product/box-studies">Box studies</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Want these shoppers on your question?"
    body="Tell us the brand and the decision. A person reviews every request and writes back."
  />
</BaseLayout>

<style>
  .shop-eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.15rem;
  }

  .shop-headline {
    font-family: var(--sans);
    font-size: clamp(1.85rem, 3.8vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    max-width: 16ch;
    color: var(--ink);
    margin-bottom: 1.15rem;
  }

  .shop-sub {
    font-size: clamp(1.02rem, 1.5vw, 1.12rem);
    color: var(--ink-light);
    max-width: 42ch;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .shop-hero-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid var(--warm-light);
    border-radius: 16px;
    padding: 1.35rem 1.4rem 1.25rem;
    box-shadow: 0 18px 40px rgba(24, 21, 15, 0.06);
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .shop-hero-card:hover {
    transform: translateY(-3px);
    border-color: rgba(62, 107, 74, 0.28);
    box-shadow: 0 22px 48px rgba(24, 21, 15, 0.1);
  }

  .shop-hero-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .shop-hero-sim {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm);
    border: 1px solid rgba(184, 144, 106, 0.45);
    padding: 0.25rem 0.45rem;
    border-radius: 2px;
  }

  .shop-hero-loc {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-lighter);
  }

  .shop-hero-card-title {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }

  .shop-hero-card-meta {
    font-size: 0.78rem;
    color: var(--ink-lighter);
    margin: 0 0 1rem;
  }

  .shop-rank {
    border-top: 1px solid var(--warm-light);
    padding-top: 0.85rem;
    margin-bottom: 0.35rem;
  }

  .shop-rank-champ-label,
  .shop-rank-also {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin: 0 0 0.35rem;
    font-weight: 500;
  }

  .shop-rank-also {
    margin-top: 0.85rem;
    margin-bottom: 0.2rem;
    color: var(--ink-lighter);
  }

  .shop-rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .shop-rank-row {
    display: grid;
    grid-template-columns: 1.65rem 2.5rem minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--warm-light);
  }

  .shop-rank-list .shop-rank-row:last-child {
    border-bottom: none;
  }

  .shop-rank-row.is-champ {
    padding: 0.35rem 0 0.65rem;
    border-bottom: 1px solid var(--warm-light);
  }

  .shop-rank-n {
    font-family: var(--serif);
    font-variant-numeric: tabular-nums;
    font-size: 1.15rem;
    line-height: 1;
    text-align: center;
    color: var(--ink-lighter);
  }

  .shop-rank-row.is-champ .shop-rank-n {
    font-size: 2.15rem;
    color: var(--warm);
    letter-spacing: -0.03em;
  }

  .shop-rank-thumb {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    overflow: hidden;
    background: #151E18;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .shop-rank-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-rank-thumb.is-b {
    background: #2a2218;
  }

  .shop-rank-thumb.is-letter::before {
    content: attr(data-letter);
    font-family: var(--serif);
    font-size: 1.1rem;
    color: rgba(250, 248, 243, 0.88);
  }

  .shop-rank-thumb.is-letter {
    background: #24322a;
  }

  .shop-rank-thumb.is-mute {
    background: #3a3330;
  }

  .shop-rank-thumb.is-atlas {
    background: #1e2a32;
  }

  .shop-rank-body {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .shop-rank-name {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shop-rank-row.is-champ .shop-rank-name {
    font-size: 0.95rem;
  }

  .shop-rank-meta {
    font-size: 0.7rem;
    color: var(--ink-lighter);
  }

  .shop-rank-tried {
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
    border: 1px solid rgba(62, 107, 74, 0.28);
    background: rgba(62, 107, 74, 0.06);
    padding: 0.22rem 0.4rem;
    border-radius: 99px;
    font-weight: 600;
    white-space: nowrap;
  }

  .shop-hero-foot {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 0 1rem;
    border-top: 1px solid var(--warm-light);
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--ink-light);
    line-height: 1.4;
  }

  .shop-hero-foot b {
    font-weight: 600;
    color: var(--ink);
  }

  .shop-hero-go {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    font-weight: 500;
  }

  .shop-hero-card:hover .shop-hero-go {
    color: var(--field);
  }

  .shop-section {
    padding: clamp(3.5rem, 7vw, 5rem) var(--page-pad);
    border-bottom: 1px solid var(--warm-light);
    background: var(--cream);
  }

  .shop-section.mid {
    background: var(--cream-mid);
  }

  .shop-h2 {
    font-family: var(--sans);
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    max-width: 22ch;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .shop-lead {
    font-size: 1.05rem;
    color: var(--ink-light);
    line-height: 1.6;
    max-width: 48ch;
    margin: 0 0 2.25rem;
  }

  .shop-note {
    margin-top: 1.75rem;
    font-size: 0.92rem;
    color: var(--ink-lighter);
    line-height: 1.55;
  }

  .shop-note a {
    color: var(--sage);
    text-decoration: none;
    font-weight: 500;
    margin-left: 0.35rem;
  }

  .shop-note a:hover {
    text-decoration: underline;
  }

  .shop-beat {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
    max-width: 56rem;
  }

  .shop-pick {
    background: #fff;
    border: 1px solid var(--warm-light);
    border-radius: 16px;
    padding: 1.35rem 1.25rem 1.15rem;
    box-shadow: 0 18px 40px rgba(24, 21, 15, 0.06);
  }

  .shop-pick-arena {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: end;
  }

  .shop-pick-half {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 0.5rem 0.75rem;
    border-radius: 12px;
    background: var(--cream);
    border: 1px solid var(--warm-light);
  }

  .shop-pick-half.is-won {
    background: rgba(62, 107, 74, 0.06);
    border-color: rgba(62, 107, 74, 0.28);
  }

  .shop-pick-half img {
    width: 72px;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  .shop-pick-half span {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-light);
  }

  .shop-pick-half.is-won span {
    color: var(--sage);
    font-weight: 500;
  }

  .shop-pick-vs {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    padding-bottom: 2.5rem;
  }

  .shop-pick-cap {
    margin: 1rem 0 0;
    text-align: center;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-lighter);
  }

  .shop-steps {
    list-style: none;
    border-top: 1px solid var(--warm-light);
  }

  .shop-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.35rem 0.85rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--warm-light);
  }

  .shop-step-n {
    grid-row: 1 / 3;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--warm);
    padding-top: 0.25rem;
  }

  .shop-steps strong {
    font-family: var(--sans);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .shop-steps span:last-child {
    font-size: 0.92rem;
    color: var(--ink-light);
    line-height: 1.45;
  }

  .ahead-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--warm-light);
    border: 1px solid var(--warm-light);
    max-width: 52rem;
  }

  .ahead-card {
    background: #fff;
    padding: 1.75rem 1.65rem;
  }

  .ahead-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }

  .ahead-card.is-box .ahead-kicker {
    color: var(--sage);
  }

  .ahead-card h3 {
    font-family: var(--sans);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.65rem;
    color: var(--ink);
    max-width: 18ch;
  }

  .ahead-card p {
    font-size: 0.95rem;
    color: var(--ink-light);
    line-height: 1.5;
    margin: 0;
  }

  .where-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 44rem;
    background: #fff;
    border: 1px solid var(--warm-light);
    border-radius: 16px;
    padding: 1.75rem 1.85rem;
    box-shadow: 0 18px 40px rgba(24, 21, 15, 0.05);
  }

  .where-n {
    display: block;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  .where-l {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-top: 0.45rem;
  }

  .where-body {
    font-size: 1.02rem;
    color: var(--ink-light);
    line-height: 1.55;
    margin: 0;
  }

  .enough-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--warm-light);
    border: 1px solid var(--warm-light);
    max-width: 52rem;
  }

  .enough-col {
    background: #fff;
    padding: 1.75rem 1.65rem;
  }

  .enough-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.85rem;
  }

  .enough-body {
    font-size: 1.02rem;
    color: var(--ink);
    line-height: 1.5;
    margin: 0;
  }

  .enough-body :global(.verdict-chip) {
    margin: 0 0.15rem;
    vertical-align: middle;
  }

  .world-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--warm-light);
    border: 1px solid var(--warm-light);
    max-width: 52rem;
    margin-bottom: 0.5rem;
  }

  .world-col {
    background: var(--cream);
    padding: 1.75rem 1.65rem;
  }

  .world-col.is-brand {
    background: #fff;
  }

  .world-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }

  .world-col.is-brand .world-eyebrow {
    color: var(--sage);
  }

  .world-body {

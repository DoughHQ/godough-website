---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import '../styles/offer-product.css';
import '../styles/shoppers.css';

/** Simulated My List fixture — personal order + Elo, not brand population standing. */
const rankingRows = [
  {
    rank: 1,
    name: 'Keel Lemon Water',
    elo: 1542,
    tried: true,
    champion: true,
    thumb: { kind: 'img' as const, src: '/demo/product-a.svg' },
  },
  {
    rank: 2,
    name: 'Rivermark Sparkling',
    elo: 1488,
    tried: true,
    thumb: { kind: 'img' as const, src: '/demo/product-b.svg', className: 'is-b' },
  },
  {
    rank: 3,
    name: 'Northveil Citrus',
    elo: 1410,
    tried: true,
    thumb: { kind: 'letter' as const, letter: 'N' },
  },
  {
    rank: 4,
    name: 'Harbor Clear',
    elo: 1364,
    tried: false,
    thumb: { kind: 'letter' as const, letter: 'H', className: 'is-mute' },
  },
  {
    rank: 5,
    name: 'Atlas Lime',
    elo: 1298,
    tried: true,
    thumb: { kind: 'letter' as const, letter: 'A', className: 'is-atlas' },
  },
];

const champion = rankingRows[0];
const alsoRanked = rankingRows.slice(1);
---

<BaseLayout
  title="Who answers — Dough"
  description="Shoppers in New York, in the Dough app, who already scan and rank products in category. That taste history is how we know who fits a study — then they choose."
  current="/shoppers"
  crumbs={[{ label: 'Shoppers' }]}
>
  <header class="shop-hero">
    <div class="shop-hero-copy">
      <p class="offer-eyebrow">Shoppers</p>
      <h1 class="offer-headline">New York shoppers who already rank.</h1>
      <p class="offer-sub">
        Not a cold panel. They scan and battle products they already buy — build a personal ranking in your category — then answer your concept or open your box as the next pick in that same act.
      </p>
      <div class="hero-actions offer-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="/method">How verdicts work</a>
      </div>
    </div>

    <a class="shop-hero-card" href="#ahead" aria-label="Simulated shopper ranking — why this panel is different">
      <div class="shop-hero-card-top">
        <span class="shop-hero-sim">Simulated</span>
        <span class="shop-hero-loc">As in the Dough app</span>
      </div>

      <div class="shop-app" aria-hidden="true">
        <p class="shop-app-crumb">Drinks</p>
        <p class="shop-app-title">
          <span class="shop-app-title-dark">Flavored</span>
          <span class="shop-app-title-sage"> water</span>
        </p>
        <div class="shop-app-level">
          <span class="shop-app-ranked">5 ranked</span>
          <span class="shop-app-level-pill">Level 2</span>
        </div>
        <div class="shop-app-track" role="presentation">
          <span class="shop-app-track-fill" style="width: 62%"></span>
        </div>
        <p class="shop-app-level-hint">3 loops to Level 3 · Friends unlocks</p>

        <div class="shop-app-tabs">
          <span class="is-on">My List</span>
          <span>Explore</span>
          <span class="is-lock"><span class="shop-app-lock" aria-hidden="true"></span>Friends<span class="shop-app-tab-hint">Level 3</span></span>
          <span class="is-lock"><span class="shop-app-lock" aria-hidden="true"></span>NYC<span class="shop-app-tab-hint">Level 4</span></span>
        </div>

        <p class="shop-rank-champ-label">Champion</p>
        <div class="shop-rank-row is-champ">
          <span class={`shop-rank-n r${champion.rank}`}>{champion.rank}</span>
          <span class="shop-rank-thumb">
            <img src={champion.thumb.kind === 'img' ? champion.thumb.src : ''} alt="" width="52" height="72" />
          </span>
          <span class="shop-rank-body">
            <span class="shop-rank-name">{champion.name}</span>
            <span class="shop-rank-state">
              <span class="shop-rank-tried"><span class="shop-rank-check"></span>Tried</span>
              <span class="shop-rank-elo">{champion.elo}</span>
            </span>
          </span>
        </div>

        <div class="shop-rank-also">
          <span>Also ranked</span>
          <span class="shop-rank-also-rule"></span>
        </div>
        <ul class="shop-rank-list">
          {
            alsoRanked.map((row) => (
              <li class="shop-rank-row">
                <span class={`shop-rank-n r${row.rank}`}>{row.rank}</span>
                {row.thumb.kind === 'img' ? (
                  <span class={`shop-rank-thumb ${row.thumb.className ?? ''}`.trim()}>
                    <img src={row.thumb.src} alt="" width="52" height="72" />
                  </span>
                ) : (
                  <span
                    class={`shop-rank-thumb is-letter ${row.thumb.className ?? ''}`.trim()}
                    data-letter={row.thumb.letter}
                  />
                )}
                <span class="shop-rank-body">
                  <span class="shop-rank-name">{row.name}</span>
                  <span class="shop-rank-state">
                    {row.tried ? (
                      <span class="shop-rank-tried">
                        <span class="shop-rank-check" />
                        Tried
                      </span>
                    ) : (
                      <span class="shop-rank-not">Not tried</span>
                    )}
                    <span class="shop-rank-elo">{row.elo}</span>
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="shop-hero-foot">
        <span><b>Fit</b> — ranked in category before your study</span>
        <span><b>Then</b> — concept or box as the next pick</span>
      </div>
      <span class="shop-hero-go">Why this panel is different ↓</span>
    </a>
  </header>

  <section class="shop-section" id="how">
    <p class="section-label">How they answer</p>
    <h2 class="shop-h2">Two products. One pick. The same act every time.</h2>
    <p class="shop-lead">
      They scan a product, battle two things in a category they know, and pick. Enough picks become a personal ranking. A study is not a different kind of person — it is that same choice, with your packs or your box as the pair.
    </p>

    <div class="shop-beat">
      <div class="shop-viz" aria-hidden="true">
        <div class="shop-pick">
          <div class="shop-pick-arena">
            <div class="shop-pick-half is-won">
              <img src="/demo/product-a.svg" alt="" width="72" height="144" />
              <span>Keel</span>
            </div>
            <span class="shop-pick-vs">vs</span>
            <div class="shop-pick-half">
              <img src="/demo/product-b.svg" alt="" width="72" height="144" />
              <span>Rivermark</span>
            </div>
          </div>
          <p class="shop-pick-cap">Illustrative · fictional products · same layout as the app</p>
        </div>
      </div>
      <ol class="shop-steps">
        <li>
          <span class="shop-step-n">01</span>
          <strong>Scan</strong>
          <span>A real SKU from the living catalog</span>
        </li>
        <li>
          <span class="shop-step-n">02</span>
          <strong>Rank</strong>
          <span>Battles stack into their list in category</span>
        </li>
        <li>
          <span class="shop-step-n">03</span>
          <strong>Choose</strong>
          <span>Your concept or box as the next pick</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="shop-section mid" id="ahead">
    <p class="section-label">Why this panel is different</p>
    <h2 class="shop-h2">They already have a ranking in your category.</h2>
    <p class="shop-lead">
      Everyday scans and battles build a personal list — products they’ve tried, ordered by how they actually choose. Fit for a study comes from that history. Then they pick your pair or open your box.
    </p>

    <div class="ahead-grid">
      <article class="ahead-card">
        <p class="ahead-kicker">Concept</p>
        <h3>Same ranked shoppers. Your pair on a screen.</h3>
        <p>People who already battle the category see your design against the pack you have to beat — and pick.</p>
      </article>
      <article class="ahead-card is-box">
        <p class="ahead-kicker">Box</p>
        <h3>Already rated products like yours.</h3>
        <p>We ship to Dough shoppers who’ve already chosen in similar categories. Preference after use — then whether they’d come back.</p>
      </article>
    </div>
  </section>

  <section class="shop-section" id="where">
    <p class="section-label">Where</p>
    <h2 class="shop-h2">New York — and we say so.</h2>
    <div class="where-card">
      <div class="where-stat">
        <span class="where-n">NYC</span>
        <span class="where-l">First panel</span>
      </div>
      <p class="where-body">
        They are in the city. When the panel grows past New York, the report will say where the answers came from. Until then this site says New York — because that is the truth.
      </p>
    </div>
  </section>

  <section class="shop-section mid" id="enough">
    <p class="section-label">When enough is enough</p>
    <h2 class="shop-h2">A handful of taps is not a result.</h2>
    <div class="enough-grid">
      <div class="enough-col">
        <p class="enough-eyebrow">Concept bar</p>
        <p class="enough-body">Under ten completed answers reads <span class="verdict-chip not_enough_responses">Not enough responses</span> — not a pass, not a fail.</p>
      </div>
      <div class="enough-col">
        <p class="enough-eyebrow">Standing</p>
        <p class="enough-body">Everyday competition on a claimed product waits until the choices are thick enough to be a pattern.</p>
      </div>
    </div>
    <p class="shop-note">
      Same floor as the report. <a href="/method">Method →</a>
    </p>
  </section>

  <section class="shop-section" id="world">
    <p class="section-label">One preference world</p>
    <h2 class="shop-h2">Brands and shoppers share the picks. Not the homepage.</h2>
    <div class="world-grid">
      <div class="world-col">
        <p class="world-eyebrow">Shoppers</p>
        <p class="world-body">Shape your plate — scan, battle, choose honestly.</p>
        <a href="/app">The shopper app →</a>
      </div>
      <div class="world-col is-brand">
        <p class="world-eyebrow">Brands</p>
        <p class="world-body">Standings, concept, and box — against that same preference.</p>
        <a href="/">For brands →</a>
      </div>
    </div>
    <nav class="shop-related" aria-label="Continue">
      <a href="/method">Method</a>
      <a href="/report/example">Example report</a>
      <a href="/product/box-studies">Box studies</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Want these shoppers on your question?"
    body="Tell us the brand and the decision. A person reviews every request and writes back."
  />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import '../styles/offer-product.css';
---

<BaseLayout
  title="Who answers — Dough"
  description="Shoppers in New York, in the Dough app, who already scan and rank products in category. That taste history is how we know who fits a study — then they choose."
  current="/shoppers"
  crumbs={[{ label: 'Shoppers' }]}
>
  <header class="shop-hero">
    <div class="shop-hero-copy">
      <p class="shop-eyebrow">Shoppers</p>
      <h1 class="shop-headline">New York shoppers who already rank.</h1>
      <p class="shop-sub">
        Not a cold panel. They scan and battle products they already buy — build a personal ranking in your category — then answer your concept or open your box as the next pick in that same act.
      </p>
      <div class="hero-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="/method">How verdicts work</a>
      </div>
    </div>

    <a class="shop-hero-card" href="#ahead" aria-label="Simulated shopper ranking — why this panel is different">
      <div class="shop-hero-card-top">
        <span class="shop-hero-sim">Simulated</span>
        <span class="shop-hero-loc">As in the Dough app</span>
      </div>

      <div class="shop-app" aria-hidden="true">
        <p class="shop-app-crumb">Drinks</p>
        <p class="shop-app-title">
          <span class="shop-app-title-dark">Flavored</span>
          <span class="shop-app-title-sage"> water</span>
        </p>
        <div class="shop-app-level">
          <span class="shop-app-ranked">5 ranked</span>
          <span class="shop-app-level-pill">Level 2</span>
        </div>
        <div class="shop-app-track" role="presentation">
          <span class="shop-app-track-fill" style="width: 62%"></span>
        </div>
        <p class="shop-app-level-hint">3 loops to Level 3 · Friends unlocks</p>

        <div class="shop-app-tabs">
          <span class="is-on">My List</span>
          <span>Explore</span>
          <span class="is-lock"><span class="shop-app-lock" aria-hidden="true"></span>Friends<span class="shop-app-tab-hint">Level 3</span></span>
          <span class="is-lock"><span class="shop-app-lock" aria-hidden="true"></span>NYC<span class="shop-app-tab-hint">Level 4</span></span>
        </div>

        <p class="shop-rank-champ-label">Champion</p>
        <div class="shop-rank-row is-champ">
          <span class="shop-rank-n r1">1</span>
          <span class="shop-rank-thumb">
            <img src="/demo/product-a.svg" alt="" width="52" height="72" />
          </span>
          <span class="shop-rank-body">
            <span class="shop-rank-name">Keel Lemon Water</span>
            <span class="shop-rank-state">
              <span class="shop-rank-tried"><span class="shop-rank-check"></span>Tried</span>
              <span class="shop-rank-elo">1542</span>
            </span>
          </span>
        </div>

        <div class="shop-rank-also">
          <span>Also ranked</span>
          <span class="shop-rank-also-rule"></span>
        </div>
        <ul class="shop-rank-list">
          <li class="shop-rank-row">
            <span class="shop-rank-n r2">2</span>
            <span class="shop-rank-thumb is-b">
              <img src="/demo/product-b.svg" alt="" width="52" height="72" />
            </span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Rivermark Sparkling</span>
              <span class="shop-rank-state">
                <span class="shop-rank-tried"><span class="shop-rank-check"></span>Tried</span>
                <span class="shop-rank-elo">1488</span>
              </span>
            </span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n r3">3</span>
            <span class="shop-rank-thumb is-letter" data-letter="N"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Northveil Citrus</span>
              <span class="shop-rank-state">
                <span class="shop-rank-tried"><span class="shop-rank-check"></span>Tried</span>
                <span class="shop-rank-elo">1410</span>
              </span>
            </span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n r4">4</span>
            <span class="shop-rank-thumb is-letter is-mute" data-letter="H"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Harbor Clear</span>
              <span class="shop-rank-state">
                <span class="shop-rank-not">Not tried</span>
                <span class="shop-rank-elo">1364</span>
              </span>
            </span>
          </li>
          <li class="shop-rank-row">
            <span class="shop-rank-n r5">5</span>
            <span class="shop-rank-thumb is-letter is-atlas" data-letter="A"></span>
            <span class="shop-rank-body">
              <span class="shop-rank-name">Atlas Lime</span>
              <span class="shop-rank-state">
                <span class="shop-rank-tried"><span class="shop-rank-check"></span>Tried</span>
                <span class="shop-rank-elo">1298</span>
              </span>
            </span>
          </li>
        </ul>
      </div>

      <div class="shop-hero-foot">
        <span><b>Fit</b> — ranked in category before your study</span>
        <span><b>Then</b> — concept or box as the next pick</span>
      </div>
      <span class="shop-hero-go">Why this panel is different ↓</span>
    </a>
  </header>

  <!-- How they answer -->
  <section class="shop-section" id="how">
    <p class="section-label">How they answer</p>
    <h2 class="shop-h2">Two products. One pick. The same act every time.</h2>
    <p class="shop-lead">
      They scan a product, battle two things in a category they know, and pick. Enough picks become a personal ranking. A study is not a different kind of person — it is that same choice, with your packs or your box as the pair.
    </p>

    <div class="shop-beat">
      <div class="shop-viz" aria-hidden="true">
        <div class="shop-pick">
          <div class="shop-pick-arena">
            <div class="shop-pick-half is-won">
              <img src="/demo/product-a.svg" alt="" width="72" height="144" />
              <span>Keel</span>
            </div>
            <span class="shop-pick-vs">vs</span>
            <div class="shop-pick-half">
              <img src="/demo/product-b.svg" alt="" width="72" height="144" />
              <span>Rivermark</span>
            </div>
          </div>
          <p class="shop-pick-cap">Illustrative · fictional products · same layout as the app</p>
        </div>
      </div>
      <ol class="shop-steps">
        <li>
          <span class="shop-step-n">01</span>
          <strong>Scan</strong>
          <span>A real SKU from the living catalog</span>
        </li>
        <li>
          <span class="shop-step-n">02</span>
          <strong>Rank</strong>
          <span>Battles stack into their list in category</span>
        </li>
        <li>
          <span class="shop-step-n">03</span>
          <strong>Choose</strong>
          <span>Your concept or box as the next pick</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Head start -->
  <section class="shop-section mid" id="ahead">
    <p class="section-label">Why this panel is different</p>
    <h2 class="shop-h2">They already have a ranking in your category.</h2>
    <p class="shop-lead">
      Everyday scans and battles build a personal list — products they’ve tried, ordered by how they actually choose. Fit for a study comes from that history. Then they pick your pair or open your box.
    </p>

    <div class="ahead-grid">
      <article class="ahead-card">
        <p class="ahead-kicker">Concept</p>
        <h3>Same ranked shoppers. Your pair on a screen.</h3>
        <p>People who already battle the category see your design against the pack you have to beat — and pick.</p>
      </article>
      <article class="ahead-card is-box">
        <p class="ahead-kicker">Box</p>
        <h3>Already rated products like yours.</h3>
        <p>We ship to Dough shoppers who’ve already chosen in similar categories. Preference after use — then whether they’d come back.</p>
      </article>
    </div>
  </section>

  <!-- Where -->
  <section class="shop-section" id="where">
    <p class="section-label">Where</p>
    <h2 class="shop-h2">New York — and we say so.</h2>
    <div class="where-card">
      <div class="where-stat">
        <span class="where-n">NYC</span>
        <span class="where-l">First panel</span>
      </div>
      <p class="where-body">
        They are in the city. When the panel grows past New York, the report will say where the answers came from. Until then this site says New York — because that is the truth.
      </p>
    </div>
  </section>

  <!-- Enough -->
  <section class="shop-section mid" id="enough">
    <p class="section-label">When enough is enough</p>
    <h2 class="shop-h2">A handful of taps is not a result.</h2>
    <div class="enough-grid">
      <div class="enough-col">
        <p class="enough-eyebrow">Concept bar</p>
        <p class="enough-body">Under ten completed answers reads <span class="verdict-chip not_enough_responses">Not enough responses</span> — not a pass, not a fail.</p>
      </div>
      <div class="enough-col">
        <p class="enough-eyebrow">Standing</p>
        <p class="enough-body">Everyday competition on a claimed product waits until the choices are thick enough to be a pattern.</p>
      </div>
    </div>
    <p class="shop-note">
      Same floor as the report. <a href="/method">Method →</a>
    </p>
  </section>

  <!-- Same world -->
  <section class="shop-section" id="world">
    <p class="section-label">One preference world</p>
    <h2 class="shop-h2">Brands and shoppers share the picks. Not the homepage.</h2>
    <div class="world-grid">
      <div class="world-col">
        <p class="world-eyebrow">Shoppers</p>
        <p class="world-body">Shape your plate — scan, battle, choose honestly.</p>
        <a href="/app">The shopper app →</a>
      </div>
      <div class="world-col is-brand">
        <p class="world-eyebrow">Brands</p>
        <p class="world-body">Standings, concept, and box — against that same preference.</p>
        <a href="/">For brands →</a>
      </div>
    </div>
    <nav class="shop-related" aria-label="Continue">
      <a href="/method">Method</a>
      <a href="/report/example">Example report</a>
      <a href="/product/box-studies">Box studies</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Want these shoppers on your question?"
    body="Tell us the brand and the decision. A person reviews every request and writes back."
  />
</BaseLayout>

<style>
  .shop-eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.15rem;
  }

  .shop-headline {
    font-family: var(--sans);
    font-size: clamp(1.85rem, 3.8vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    max-width: 16ch;
    color: var(--ink);
    margin-bottom: 1.15rem;
  }

  .shop-sub {
    font-size: clamp(1.02rem, 1.5vw, 1.12rem);
    color: var(--ink-light);
    max-width: 42ch;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .shop-hero-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 18px;
    padding: 1rem 1rem 1.15rem;
    box-shadow: 0 18px 40px rgba(24, 21, 15, 0.07);
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .shop-hero-card:hover {
    transform: translateY(-3px);
    border-color: rgba(62, 107, 74, 0.28);
    box-shadow: 0 22px 48px rgba(24, 21, 15, 0.11);
  }

  .shop-hero-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding: 0 0.15rem;
  }

  .shop-hero-sim {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid rgba(192, 120, 24, 0.4);
    padding: 0.25rem 0.45rem;
    border-radius: 2px;
  }

  .shop-hero-loc {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9b9b9b;
  }

  .shop-app {
    background: #faf8f3;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 14px;
    padding: 0.85rem 0.55rem 0.55rem;
    margin-bottom: 0.15rem;
  }

  .shop-app-crumb {
    font-size: 0.72rem;
    color: #6b6b6b;
    margin: 0 0.65rem 0.15rem;
  }

  .shop-app-title {
    font-family: var(--serif-app);
    font-size: 1.55rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0.65rem 0.55rem;
    font-weight: 400;
  }

  .shop-app-title-dark { color: #1a1a1a; }
  .shop-app-title-sage { color: #3e6b4a; }

  .shop-app-level {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0.65rem 0.35rem;
  }

  .shop-app-ranked { font-size: 0.78rem; color: #1a1a1a; }

  .shop-app-level-pill {
    background: #3e6b4a;
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 0.18rem 0.5rem;
    border-radius: 99px;
  }

  .shop-app-track {
    height: 3px;
    border-radius: 99px;
    background: rgba(62, 107, 74, 0.12);
    overflow: hidden;
    margin: 0 0.65rem 0.3rem;
  }

  .shop-app-track-fill {
    display: block;
    height: 100%;
    background: #3e6b4a;
    border-radius: 99px;
  }

  .shop-app-level-hint {
    font-size: 0.66rem;
    color: #6b6b6b;
    margin: 0 0.65rem 0.7rem;
  }

  .shop-app-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin: 0 0.35rem 0.85rem;
  }

  .shop-app-tabs > span {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 2.35rem;
    padding: 0.28rem 0.15rem;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: #faf8f3;
    font-size: 0.58rem;
    font-weight: 600;
    color: #6b6b6b;
    text-align: center;
    line-height: 1.15;
  }

  .shop-app-tabs > span.is-on {
    background: #3e6b4a;
    border-color: #3e6b4a;
    color: #fff;
  }

  .shop-app-tabs > span.is-lock {
    opacity: 0.72;
    color: #9b9b9b;
  }

  .shop-app-lock {
    display: block;
    width: 8px;
    height: 9px;
    margin-bottom: 1px;
    border: 1.5px solid #9b9b9b;
    border-radius: 2px 2px 1px 1px;
    position: relative;
  }

  .shop-app-lock::before {
    content: '';
    position: absolute;
    left: 1px;
    top: -4px;
    width: 4px;
    height: 4px;
    border: 1.5px solid #9b9b9b;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
  }

  .shop-app-tab-hint {
    font-size: 0.48rem;
    font-weight: 400;
    color: #9b9b9b;
  }

  .shop-rank-champ-label {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0.65rem 0.15rem;
  }

  .shop-rank-also {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.7rem 0.65rem 0.2rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9b9b9b;
  }

  .shop-rank-also-rule {
    flex: 1;
    height: 1px;
    background: rgba(0, 0, 0, 0.1);
  }

  .shop-rank-list { list-style: none; margin: 0; padding: 0; }

  .shop-rank-row {
    display: grid;
    grid-template-columns: 2rem 2.85rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: stretch;
    padding: 0.55rem 0.45rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    min-height: 4.6rem;
  }

  .shop-rank-list .shop-rank-row:last-child { border-bottom: none; }

  .shop-rank-row.is-champ {
    padding-top: 0.35rem;
    padding-bottom: 0.65rem;
  }

  .shop-rank-n {
    font-family: var(--serif-app);
    font-variant-numeric: tabular-nums;
    font-size: 1.55rem;
    line-height: 1;
    text-align: center;
    align-self: center;
    font-weight: 400;
  }

  .shop-rank-n.r1 { font-size: 2rem; color: #c07818; }
  .shop-rank-n.r2 { color: rgba(62, 107, 74, 0.48); }
  .shop-rank-n.r3 { color: rgba(62, 107, 74, 0.34); }
  .shop-rank-n.r4 { color: rgba(62, 107, 74, 0.24); }
  .shop-rank-n.r5 { color: rgba(62, 107, 74, 0.16); }

  .shop-rank-thumb {
    width: 2.85rem;
    height: 3.9rem;
    border-radius: 10px;
    overflow: hidden;
    background: #efebe2;
    border: 1px solid rgba(36, 61, 44, 0.06);
    display: grid;
    place-items: center;
    align-self: center;
    flex-shrink: 0;
  }

  .shop-rank-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-rank-thumb.is-b { background: #2a2218; }
  .shop-rank-thumb.is-letter { background: rgba(62, 107, 74, 0.04); }
  .shop-rank-thumb.is-letter::before {
    content: attr(data-letter);
    font-family: var(--serif-app);
    font-size: 1.25rem;
    color: rgba(62, 107, 74, 0.32);
  }
  .shop-rank-thumb.is-mute { background: rgba(0, 0, 0, 0.04); }
  .shop-rank-thumb.is-mute::before { color: rgba(0, 0, 0, 0.22); }
  .shop-rank-thumb.is-atlas { background: rgba(30, 42, 50, 0.08); }
  .shop-rank-thumb.is-atlas::before { color: rgba(30, 42, 50, 0.4); }

  .shop-rank-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: 0.1rem 0 0.05rem;
  }

  .shop-rank-name {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1a1f1b;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .shop-rank-row.is-champ .shop-rank-name { font-size: 0.95rem; }

  .shop-rank-state {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.45rem;
  }

  .shop-rank-tried,
  .shop-rank-not {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .shop-rank-tried { color: #3e6b4a; }
  .shop-rank-not { color: #98a49b; }

  .shop-rank-check {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #3e6b4a;
    position: relative;
    flex-shrink: 0;
  }

  .shop-rank-check::after {
    content: '';
    position: absolute;
    left: 0.18rem;
    top: 0.1rem;
    width: 0.22rem;
    height: 0.38rem;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .shop-rank-not::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1.5px solid #98a49b;
    flex-shrink: 0;
  }

  .shop-rank-elo {
    font-size: 0.88rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: #6e7c71;
    line-height: 1;
  }

  .shop-hero-foot {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 0.25rem 0.95rem;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--ink-light);
    line-height: 1.4;
  }

  .shop-hero-foot b {
    font-weight: 600;
    color: var(--ink);
  }

  .shop-hero-go {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    font-weight: 500;
    padding: 0 0.25rem;
  }

  .shop-hero-card:hover .shop-hero-go {
    color: var(--field);
  }

  .shop-section {
    padding: clamp(3.5rem, 7vw, 5rem) var(--page-pad);
    border-bottom: 1px solid var(--warm-light);
    background: var(--cream);
  }

  .shop-section.mid {
    background: var(--cream-mid);
  }

  .shop-h2 {
    font-family: var(--sans);
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    max-width: 22ch;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .shop-lead {
    font-size: 1.05rem;
    color: var(--ink-light);
    line-height: 1.6;
    max-width: 48ch;
    margin: 0 0 2.25rem;
  }

  .shop-note {
    margin-top: 1.75rem;
    font-size: 0.92rem;
    color: var(--ink-lighter);
    line-height: 1.55;
  }

  .shop-note a {
    color: var(--sage);
    text-decoration: none;
    font-weight: 500;
    margin-left: 0.35rem;
  }

  .shop-note a:hover {
    text-decoration: underline;
  }

  .shop-beat {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
    max-width: 56rem;
  }

  .shop-pick {
    background: #fff;

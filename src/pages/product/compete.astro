---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PORTAL_ORIGIN } from '../../data/site';
import '../../styles/offer-product.css';
import '../../styles/compete.css';

const WORKSPACE_HOME = `${PORTAL_ORIGIN}/marketing/workspace/home`

/**
 * Simulated category PreferenceField — portal ranking chrome with fixture Elo.
 * Labeled Simulated; not a live brand account. Ordinals are field order, not
 * invented “#N of M” catalog claims.
 */
const field = [
  { rank: 1, name: 'Rivermark Sparkling', brand: 'Rivermark', elo: 1548, pct: 88, focal: false },
  { rank: 2, name: 'Keel Lemon Water', brand: 'Keel', elo: 1492, pct: 72, focal: true },
  { rank: 3, name: 'Northveil Citrus', brand: 'Northveil', elo: 1416, pct: 48, focal: false },
  { rank: 4, name: 'Harbor Clear', brand: 'Harbor', elo: 1360, pct: 32, focal: false },
  { rank: 5, name: 'Atlas Lime', brand: 'Atlas', elo: 1294, pct: 14, focal: false },
]
---

<BaseLayout
  title="How you compete — Dough"
  description="Claim your products in the Dough catalog. Shoppers battle them head-to-head in category — Elo rankings show where you stand and what you’re compared against."
  current="/product/compete"
  crumbs={[{ href: '/product/compete', label: 'Product' }, { label: 'How you compete' }]}
>
  <header class="offer-hero is-standing">
    <div class="offer-hero-copy">
      <p class="offer-eyebrow">Product · Compete</p>
      <h1 class="offer-headline">
        Claim the catalog. See how shoppers rank you against the field.
      </h1>
      <p class="offer-sub">
        Your SKUs sit on the same shelf shoppers battle every day. Head-to-head picks feed an Elo ranking in category — who you beat, who beats you, and where signal is still too thin to say.
      </p>
      <div class="hero-actions offer-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="#report">See the workspace</a>
      </div>
    </div>

    <a class="compete-card" href="#report" aria-label="Simulated category preference ranking — see the brand workspace">
      <div class="compete-card-top">
        <span class="compete-sim">Simulated</span>
        <span class="compete-loc">As in the brand workspace</span>
      </div>

      <div class="compete-field" aria-hidden="true">
        <p class="compete-field-kicker">Category preference</p>
        <p class="compete-field-title">Preference ranking</p>
        <p class="compete-field-meta">Flavored water · head-to-heads from ordinary app picks</p>

        <div class="compete-axis">
          <span>Weaker</span>
          <span>Stronger</span>
        </div>

        <ul class="compete-rank-list">
          {
            field.map((row) => (
              <li
                class:list={[
                  'compete-rank-row',
                  row.rank <= 3 && 'is-top',
                  row.focal && 'is-focal',
                ]}
              >
                <span class="compete-rank-n">{row.rank}</span>
                <span class="compete-rank-body">
                  <span class="compete-rank-name-row">
                    <span class="compete-rank-name">{row.name}</span>
                    {row.focal ? <span class="compete-rank-chip">Your product</span> : null}
                  </span>
                  <span class="compete-rank-brand">{row.brand}</span>
                </span>
                <span class="compete-elo">
                  <span class="compete-elo-track" />
                  <span class="compete-elo-dot" style={`left: ${row.pct}%`} />
                  <span class="compete-elo-num">{row.elo}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="compete-card-foot">
        <span><b>Claim</b> — your SKUs in the living catalog</span>
        <span><b>Insight</b> — ranking + rivals from real head-to-heads</span>
      </div>
      <span class="compete-card-go">See the brand workspace ↓</span>
    </a>
  </header>

  <section class="offer-explain" aria-label="In five seconds">
    <ol class="offer-beats">
      <li>
        <span class="offer-beat-n">01</span>
        <strong>Claim the catalog</strong>
        <span>What’s yours, what’s missing, what needs a cleaner read</span>
      </li>
      <li>
        <span class="offer-beat-n">02</span>
        <strong>See insights</strong>
        <span>Category ranking from head-to-heads — only where signal is thick enough</span>
      </li>
    </ol>
  </section>

  <section class="section">
    <p class="section-label">How competition works</p>
    <h2 class="section-headline sell">Head-to-head picks. Elo in category. A standing when the field is thick.</h2>
    <ul class="when-list">
      <li>
        <strong>Matchups</strong>
        <span>Shoppers pick between two real products in a category they know — including yours.</span>
      </li>
      <li>
        <strong>Ranking</strong>
        <span>Enough battles become an Elo preference field: your SKU against the alternatives.</span>
      </li>
      <li>
        <strong>Insight</strong>
        <span>Where you hold up, who beats you, and which categories are still building.</span>
      </li>
    </ul>
  </section>

  <section class="section mid">
    <p class="section-label">Why compete first</p>
    <h2 class="section-headline sell">A standing is not a study. A study is not a standing.</h2>
    <div class="offer-contrast">
      <div class="offer-contrast-col is-this">
        <p class="offer-contrast-label">Compete</p>
        <p class="offer-contrast-body">Ordinary app battles. A category ranking when choices are thick enough.</p>
        <span class="offer-contrast-now">You are here</span>
      </div>
      <div class="offer-contrast-col">
        <p class="offer-contrast-label">Concept / box</p>
        <p class="offer-contrast-body">A question you commission — bars, a deadline, a verdict that can fail.</p>
        <a href="/product/concept-tests">Concept tests →</a>
      </div>
    </div>
  </section>

  <section class="section" id="report">
    <p class="section-label">What you get back</p>
    <h2 class="section-headline sell">Claimed products, category standings, and a place to run the next question.</h2>
    <p class="section-body">
      Live preview of the brand home in the portal. Simulated fixture. Not a live account.
    </p>
    <figure class="offer-report-frame">
      <div class="chrome">
        <div class="chrome-bar" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="url">{WORKSPACE_HOME.replace('https://', '')}</span>
        </div>
        <iframe
          class="portal-frame"
          src={WORKSPACE_HOME}
          title="Simulated brand workspace home from the Dough portal"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <figcaption class="offer-report-note">
        Same workspace brands open after access — claim products, open categories with signal, then studies.
        <a href="/product/workspace">More workspace views →</a>
      </figcaption>
    </figure>
    <nav class="related" aria-label="Continue">
      <a href="/product/concept-tests">Concept tests</a>
      <a href="/product/box-studies">Box studies</a>
      <a href="/product/workspace">The workspace</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Claim what’s yours."
    body="Tell us the brand. A person reviews every request and writes back."
  />
</BaseLayout>

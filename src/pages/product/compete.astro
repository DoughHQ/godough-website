---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/offer-product.css';

const WORKSPACE_HOME = 'https://brands.godough.co/marketing/workspace/home'
---

<BaseLayout
  title="How you compete — Dough"
  description="Your products are already in the Dough catalog. Where enough New York shoppers have chosen, see how a product holds up against the alternatives."
  current="/product/compete"
  crumbs={[{ href: '/product/compete', label: 'Product' }, { label: 'How you compete' }]}
>
  <header class="offer-hero">
    <div class="offer-hero-copy">
      <p class="offer-eyebrow">Product · Compete</p>
      <h1 class="offer-headline">
        Your SKUs are already on the shelf shoppers battle. See where you hold up.
      </h1>
      <p class="offer-sub">
        Claim what’s yours. Where New York shoppers have made enough head-to-head picks, see how a product fares against the alternatives — not a survey score, a pattern of real choices.
      </p>
      <div class="hero-actions offer-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="#report">See the workspace</a>
      </div>
    </div>

    <a class="offer-payoff" href="#report">
      <div class="payoff-top">
        <span class="payoff-sim">Simulated</span>
        <span class="payoff-brand">Keel</span>
      </div>
      <p class="payoff-product">Keel Lemon Water</p>
      <p class="payoff-meta">Flavored water · standing from ordinary app picks</p>

      <div class="payoff-metrics">
        <div class="payoff-metric">
          <span class="payoff-label">Signal</span>
          <span class="payoff-numeral is-ok">Gaining</span>
          <span class="payoff-unit">preference strength</span>
          <span class="payoff-caption">Winning more head-to-heads lately</span>
        </div>
        <div class="payoff-metric">
          <span class="payoff-label">Battles counted</span>
          <span class="payoff-numeral">184</span>
          <span class="payoff-unit">in category</span>
          <span class="payoff-caption">Still water still building — not thick enough yet</span>
        </div>
      </div>

      <div class="payoff-drivers">
        <span><b>One pick is a fact</b> — a standing needs a pattern</span>
        <span><b>Not a verdict</b> — and not a sales forecast</span>
      </div>

      <span class="payoff-go">See the brand workspace ↓</span>
    </a>
  </header>

  <section class="offer-explain" aria-label="In five seconds">
    <ol class="offer-beats">
      <li>
        <span class="offer-beat-n">01</span>
        <strong>Claim the catalog</strong>
        <span>What’s yours, what’s missing, what needs a cleaner read</span>
      </li>
      <li>
        <span class="offer-beat-n">02</span>
        <strong>See the standing</strong>
        <span>Only where enough shoppers have already chosen</span>
      </li>
    </ol>
  </section>

  <section class="section">
    <p class="section-label">When to compete</p>
    <h2 class="section-headline sell">Three questions the catalog answers before you brief a study.</h2>
    <ul class="when-list">
      <li>
        <strong>Shelf reality</strong>
        <span>Where do shoppers already pick you — or the rival?</span>
      </li>
      <li>
        <strong>Signal gaps</strong>
        <span>Which categories aren’t thick enough yet to say anything?</span>
      </li>
      <li>
        <strong>Where to dig</strong>
        <span>Which SKU earns a concept or a box next?</span>
      </li>
    </ul>
  </section>

  <section class="section mid">
    <p class="section-label">Why compete first</p>
    <h2 class="section-headline sell">A standing is not a study. A study is not a standing.</h2>
    <div class="offer-contrast">
      <div class="offer-contrast-col is-this">
        <p class="offer-contrast-label">Compete</p>
        <p class="offer-contrast-body">Ordinary picks in the app. A pattern when the choices are thick enough.</p>
        <span class="offer-contrast-now">You are here</span>
      </div>
      <div class="offer-contrast-col">
        <p class="offer-contrast-label">Concept / box</p>
        <p class="offer-contrast-body">A question you commission — bars, a deadline, a verdict that can fail.</p>
        <a href="/product/concept-tests">Concept tests →</a>
      </div>
    </div>
  </section>

  <section class="section" id="report">
    <p class="section-label">What you get back</p>
    <h2 class="section-headline sell">Claimed products, category signal, and a place to run the next question.</h2>
    <p class="section-body">
      Live preview of the brand home in the portal. Simulated fixture. Not a live account.
    </p>
    <figure class="offer-report-frame">
      <div class="chrome">
        <div class="chrome-bar" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="url">brands.godough.co/marketing/workspace/home</span>
        </div>
        <iframe
          class="portal-frame"
          src={WORKSPACE_HOME}
          title="Simulated brand workspace home from the Dough portal"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <figcaption class="offer-report-note">
        Same workspace brands open after access — products, categories with signal, and studies.
        <a href="/product/workspace">More workspace views →</a>
      </figcaption>
    </figure>
    <nav class="related" aria-label="Continue">
      <a href="/product/concept-tests">Concept tests</a>
      <a href="/product/box-studies">Box studies</a>
      <a href="/product/workspace">The workspace</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Claim what’s yours."
    body="Tell us the brand. A person reviews every request and writes back."
  />
</BaseLayout>

<style>
  /* Compete payoff uses a wordy numeral — keep it readable */
  .offer-payoff :global(.payoff-numeral.is-ok) {
    font-size: clamp(1.55rem, 2.8vw, 1.95rem);
    line-height: 1.15;
    padding-top: 0.15rem;
  }
</style>

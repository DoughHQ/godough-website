---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfferRelated from '../../components/OfferRelated.astro';
import CtaBand from '../../components/CtaBand.astro';
---

<BaseLayout
  title="Box studies — Dough"
  description="Send your product to a New York shopper. They use it at home, then choose. Ask again later if you need to know whether they’d come back."
  current="/product/box-studies"
  crumbs={[{ href: '/product/compete', label: 'Product' }, { label: 'Box studies' }]}
>
  <header class="box-hero">
    <p class="box-eyebrow">Product · Box studies</p>
    <h1 class="box-headline">
      Your product. A New York kitchen. A real choice after they use it.
    </h1>
    <p class="box-sub">
      We ship the SKU to a Dough shopper. They try it at home, pick against an alternative, and say why. Need to know if they’d come back? A second session follows at least a day later.
    </p>
    <div class="hero-actions box-actions">
      <a class="btn-primary on-cream" href="/access">
        Request access <span class="arr" aria-hidden="true">→</span>
      </a>
      <a class="btn-ghost on-cream" href="/product/concept-tests">Compare to concept tests</a>
    </div>
  </header>

  <section class="box-explain" aria-label="In five seconds">
    <ol class="box-beats box-beats-two">
      <li>
        <span class="box-beat-n">01</span>
        <strong>Ship</strong>
        <span>To real consumers who’ve rated products similar to yours</span>
      </li>
      <li>
        <span class="box-beat-n">02</span>
        <strong>Use, then choose</strong>
        <span>Get the feedback — and a follow-up when repeat matters</span>
      </li>
    </ol>
  </section>

  <section class="section">
    <p class="section-label">Why a box</p>
    <h2 class="section-headline sell">On-screen preference is not the same as preference after use.</h2>
    <p class="section-body">
      Concept tests put two packs on a screen. A box study puts the real thing in someone’s hands. You learn what holds up after they open it, pour it, cook with it — then choose.
    </p>
    <div class="box-contrast">
      <div class="box-contrast-col">
        <p class="box-contrast-label">Concept test</p>
        <p class="box-contrast-body">Two designs on a phone. Shoppers pick from looking.</p>
        <a href="/product/concept-tests">Concept tests →</a>
      </div>
      <div class="box-contrast-col is-this">
        <p class="box-contrast-label">Box study</p>
        <p class="box-contrast-body">The physical product at home. Shoppers pick after using it.</p>
        <span class="box-contrast-now">You are here</span>
      </div>
    </div>
  </section>

  <section class="section mid">
    <p class="section-label">How a box runs</p>
    <h2 class="section-headline sell">Two moves. Recruiting and setup stay with Dough.</h2>
    <div class="box-path box-path-two">
      <div class="box-path-step">
        <p class="box-path-n">01</p>
        <h3>Ship to real consumers who’ve rated products similar to yours</h3>
        <p>Dough shoppers in New York — people who already choose in categories next to yours. Not a rented panel.</p>
      </div>
      <div class="box-path-step">
        <p class="box-path-n">02</p>
        <h3>Use, then choose — get feedback</h3>
        <p>After they use it at home, they pick against an alternative and say why. Need to know if they’d come back? A second session can follow at least a day later.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="section-label">What you get back</p>
    <h2 class="section-headline sell">Preference after use — and whether they’d buy again.</h2>
    <p class="section-body">
      Live preview of the real box report in the brand portal. Simulated fixture data. Not a client study.
    </p>
    <figure class="box-report-frame">
      <div class="chrome">
        <div class="chrome-bar" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="url">brands.godough.co/marketing/workspace/box-report</span>
        </div>
        <iframe
          class="portal-frame"
          src="https://brands.godough.co/marketing/workspace/box-report"
          title="Simulated box study report from the Dough portal"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <figcaption class="box-report-note">
        The same box report brands open in the portal — preference after use, why they chose, and whether they’d buy again. Simulated data.
      </figcaption>
    </figure>
    <OfferRelated />
  </section>

  <CtaBand
    headline="Want a box in New York kitchens?"
    body="Tell us the product and the question. A person reviews every request and writes back."
  />
</BaseLayout>

<style>
  .box-hero {
    padding: 8rem var(--page-pad) 3.25rem;
    border-bottom: 1px solid var(--warm-light);
    background: var(--cream);
  }

  .box-eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.15rem;
  }

  .box-headline {
    font-family: var(--sans);
    font-size: clamp(1.75rem, 3.6vw, 2.65rem);
    font-weight: 600;
    font-style: normal;
    line-height: 1.15;
    letter-spacing: -0.025em;
    max-width: 20ch;
    color: var(--ink);
    margin-bottom: 1.15rem;
  }

  .box-sub {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    color: var(--ink-light);
    max-width: 42ch;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .box-actions {
    margin-top: 0.25rem;
  }

  /* Five-second strip */
  .box-explain {
    padding: 0 var(--page-pad);
    background: var(--field);
    color: var(--cream);
  }

  .box-beats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 0;
  }

  .box-beats-two {
    grid-template-columns: 1fr 1fr;
  }

  .box-beats li {
    padding: 1.75rem 1.35rem;
    border-right: 1px solid rgba(250, 248, 243, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .box-beats li:last-child { border-right: none; }

  .box-beat-n {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.35rem;
  }

  .box-beats strong {
    font-family: var(--sans);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .box-beats span:last-child {
    font-size: 0.88rem;
    color: rgba(250, 248, 243, 0.58);
    line-height: 1.45;
  }

  .section-headline.sell {
    font-family: var(--sans);
    font-weight: 600;
    font-style: normal;
    max-width: 22ch;
    letter-spacing: -0.025em;
  }

  /* Concept vs box */
  .box-contrast {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin-top: 2.5rem;
    background: var(--warm-light);
    border: 1px solid var(--warm-light);
  }

  .box-contrast-col {
    background: var(--cream);
    padding: 1.75rem 1.65rem;
  }

  .box-contrast-col.is-this {
    background: var(--cream-mid);
  }

  .box-contrast-label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }

  .box-contrast-body {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 1.15rem;
    max-width: 28ch;
  }

  .box-contrast-col a {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
    text-decoration: none;
    font-weight: 500;
  }
  .box-contrast-col a:hover { color: var(--field); }

  .box-contrast-now {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-lighter);
  }

  .box-path {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--warm-light);
  }

  .box-path-two {
    grid-template-columns: 1fr 1fr;
  }

  .box-path-step {
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-right: 1px solid var(--warm-light);
  }
  .box-path-step:last-child { border-right: none; padding-right: 0; }
  .box-path-step:not(:first-child) { padding-left: 1.5rem; }

  .box-path-n {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.85rem;
  }

  .box-path-step h3 {
    font-family: var(--sans);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.55rem;
  }

  .box-path-step p {
    font-size: 0.95rem;
    color: var(--ink-light);
    line-height: 1.55;
    max-width: 28ch;
  }

  .box-report-frame {
    margin-top: 2.25rem;
  }

  .box-report-frame .chrome {
    border: 1px solid var(--warm-light);
    border-radius: 12px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 18px 48px rgba(24, 21, 15, 0.08);
  }

  .box-report-frame .chrome-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    background: var(--cream-mid);
    border-bottom: 1px solid var(--warm-light);
  }

  .box-report-frame .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warm-light);
  }

  .box-report-frame .url {
    margin-left: 0.75rem;
    font-size: 0.7rem;
    color: var(--ink-lighter);
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .box-report-frame .portal-frame {
    display: block;
    width: 100%;
    height: min(88vh, 960px);
    border: 0;
    background: var(--cream);
  }

  .box-report-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-lighter);
    line-height: 1.55;
    max-width: 52ch;
  }

  @media (max-width: 860px) {
    .box-beats,
    .box-beats-two { grid-template-columns: 1fr; }
    .box-beats li { border-right: none; border-bottom: 1px solid rgba(250, 248, 243, 0.1); }
    .box-beats li:last-child { border-bottom: none; }
    .box-contrast { grid-template-columns: 1fr; }
    .box-path,
    .box-path-two { grid-template-columns: 1fr; }
    .box-path-step {
      border-right: none;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--warm-light);
    }
    .box-path-step:not(:first-child) { padding-left: 0; }
    .box-path-step:last-child { border-bottom: none; }
  }
</style>

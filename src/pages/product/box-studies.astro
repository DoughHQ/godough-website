---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';

const BOX_PREVIEW = 'https://brands.godough.co/marketing/workspace/box-preview'
const BOX_FULL = 'https://brands.godough.co/marketing/workspace/box-report'
---

<BaseLayout
  title="Box studies — Dough"
  description="Ship your product to New York shoppers who’ve rated similar products. They use it at home, choose, and say if they’d come back."
  current="/product/box-studies"
  crumbs={[{ href: '/product/compete', label: 'Product' }, { label: 'Box studies' }]}
>
  <header class="box-hero">
    <div class="box-hero-copy">
      <p class="box-eyebrow">Product · Box studies</p>
      <h1 class="box-headline">
        Your product. A New York kitchen. A real choice after they use it.
      </h1>
      <p class="box-sub">
        We ship to Dough shoppers who’ve already rated products like yours. They try it at home, pick against an alternative, and say why — then whether they’d come back.
      </p>
      <div class="hero-actions box-actions">
        <a class="btn-primary on-cream" href="/access">
          Request access <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost on-cream" href="#report">See what you get back</a>
      </div>
    </div>

    <a class="box-hero-visual payoff" href="#report">
      <div class="payoff-top">
        <span class="payoff-sim">Simulated</span>
        <span class="payoff-brand">Keel</span>
      </div>
      <p class="payoff-product">Keel Lemon Water</p>
      <p class="payoff-meta">64 New York shoppers · after use at home</p>

      <div class="payoff-metrics">
        <div class="payoff-metric">
          <span class="payoff-label">Preference</span>
          <span class="payoff-numeral">58</span>
          <span class="payoff-unit">of 100</span>
          <span class="payoff-track" aria-hidden="true">
            <span class="payoff-track-fill" style="width: 58%"></span>
          </span>
          <span class="payoff-caption">Chosen after they used it</span>
        </div>
        <div class="payoff-metric">
          <span class="payoff-label">Would buy again</span>
          <span class="payoff-numeral">47%</span>
          <span class="payoff-unit">definite yes</span>
          <span class="payoff-caption">72% yes or maybe · session 1</span>
        </div>
      </div>

      <div class="payoff-drivers">
        <span><b>Taste</b> led when they chose you</span>
        <span><b>Price</b> led when they didn’t</span>
      </div>

      <span class="payoff-go">See the report preview ↓</span>
    </a>
  </header>

  <section class="box-explain" aria-label="In five seconds">
    <ol class="box-beats box-beats-two">
      <li>
        <span class="box-beat-n">01</span>
        <strong>Ship</strong>
        <span>To real consumers who’ve rated products similar to yours</span>
      </li>
      <li>
        <span class="box-beat-n">02</span>
        <strong>Use, then choose</strong>
        <span>Get the feedback — and a follow-up when repeat matters</span>
      </li>
    </ol>
  </section>

  <section class="section">
    <p class="section-label">When to use a box</p>
    <h2 class="section-headline sell">Three questions a kitchen answers better than a screen.</h2>
    <ul class="when-list">
      <li>
        <strong>New formula</strong>
        <span>Will they still pick you after they’ve tasted it?</span>
      </li>
      <li>
        <strong>Relaunch / pack change</strong>
        <span>Does the new thing hold up once it’s in their hands?</span>
      </li>
      <li>
        <strong>Repeat</strong>
        <span>Would they buy it again a day later?</span>
      </li>
    </ul>
  </section>

  <section class="section mid">
    <p class="section-label">Why a box</p>
    <h2 class="section-headline sell">On-screen preference is not the same as preference after use.</h2>
    <div class="box-contrast">
      <div class="box-contrast-col">
        <p class="box-contrast-label">Concept test</p>
        <p class="box-contrast-body">Two designs on a phone. Shoppers pick from looking.</p>
        <a href="/product/concept-tests">Concept tests →</a>
      </div>
      <div class="box-contrast-col is-this">
        <p class="box-contrast-label">Box study</p>
        <p class="box-contrast-body">The physical product at home. Shoppers pick after using it.</p>
        <span class="box-contrast-now">You are here</span>
      </div>
    </div>
  </section>

  <section class="section" id="report">
    <p class="section-label">What you get back</p>
    <h2 class="section-headline sell">Preference after use — and whether they’d buy again.</h2>
    <p class="section-body">
      Cropped live preview of the real box report. Simulated fixture. Not a client study.
    </p>
    <figure class="box-report-frame">
      <div class="chrome">
        <div class="chrome-bar" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="url">brands.godough.co/marketing/workspace/box-preview</span>
        </div>
        <iframe
          class="portal-frame"
          src={BOX_PREVIEW}
          title="Simulated box study report preview from the Dough portal"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <figcaption class="box-report-note">
        Same portal report brands open after a box fields — preference, why they chose, buy-again.
        <a href={BOX_FULL}>Full report preview →</a>
      </figcaption>
    </figure>
    <nav class="related" aria-label="Continue">
      <a href={BOX_FULL}>Full box report</a>
      <a href="/method">Method</a>
      <a href="/product/workspace">The workspace</a>
      <a href="/access">Request access</a>
    </nav>
  </section>

  <CtaBand
    headline="Want a box in New York kitchens?"
    body="Tell us the product and the question. A person reviews every request and writes back."
  />
</BaseLayout>

<style>
  .box-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: 8rem var(--page-pad) 3.25rem;
    border-bottom: 1px solid var(--warm-light);
    background: var(--cream);
  }

  .box-eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.15rem;
  }

  .box-headline {
    font-family: var(--sans);
    font-size: clamp(1.75rem, 3.6vw, 2.65rem);
    font-weight: 600;
    font-style: normal;
    line-height: 1.15;
    letter-spacing: -0.025em;
    max-width: 18ch;
    color: var(--ink);
    margin-bottom: 1.15rem;
  }

  .box-sub {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    color: var(--ink-light);
    max-width: 40ch;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .box-actions { margin-top: 0.25rem; }

  /* Hero payoff card — report fragment, not an iframe */
  .box-hero-visual.payoff {
    display: block;
    text-decoration: none;
    color: var(--cream);
    background:
      radial-gradient(ellipse 80% 70% at 90% 0%, rgba(62, 107, 74, 0.45), transparent 55%),
      radial-gradient(ellipse 50% 45% at 0% 100%, rgba(184, 144, 106, 0.16), transparent 50%),
      linear-gradient(165deg, #24322a 0%, var(--field) 48%, #121816 100%);
    border-radius: 18px;
    padding: 1.65rem 1.75rem 1.5rem;
    box-shadow: 0 28px 64px rgba(24, 21, 15, 0.18);
    border: 1px solid rgba(250, 248, 243, 0.08);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
    position: relative;
    overflow: hidden;
  }

  .box-hero-visual.payoff::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    opacity: 0.35;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .box-hero-visual.payoff:hover {
    transform: translateY(-3px);
    box-shadow: 0 34px 72px rgba(24, 21, 15, 0.24);
  }

  .box-hero-visual.payoff > * {
    position: relative;
    z-index: 1;
  }

  .payoff-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  .payoff-sim {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    border: 1px solid rgba(184, 144, 106, 0.45);
    padding: 0.28rem 0.55rem;
    border-radius: 2px;
  }

  .payoff-brand {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.78);
  }

  .payoff-product {
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.4vw, 1.95rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.35rem;
  }

  .payoff-meta {
    font-size: 0.78rem;
    color: rgba(250, 248, 243, 0.78);
    margin: 0 0 1.5rem;
  }

  .payoff-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .payoff-metric {
    background: rgba(250, 248, 243, 0.06);
    border: 1px solid rgba(250, 248, 243, 0.1);
    border-radius: 12px;
    padding: 1rem 1rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .payoff-label {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.72);
    margin-bottom: 0.35rem;
  }

  .payoff-numeral {
    font-family: var(--serif);
    font-size: clamp(2.1rem, 3.5vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .payoff-unit {
    font-size: 0.72rem;
    color: rgba(250, 248, 243, 0.78);
    margin-bottom: 0.55rem;
  }

  .payoff-track {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgba(250, 248, 243, 0.18);
    overflow: hidden;
    margin: 0.25rem 0 0.55rem;
  }

  .payoff-track-fill {
    display: block;
    height: 100%;
    background: #b8d4c0;
    border-radius: 2px;
  }

  .payoff-caption {
    font-size: 0.72rem;
    color: rgba(250, 248, 243, 0.74);
    line-height: 1.35;
  }

  .payoff-drivers {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 0 1.15rem;
    border-top: 1px solid rgba(250, 248, 243, 0.14);
    font-size: 0.8rem;
    color: rgba(250, 248, 243, 0.82);
    line-height: 1.4;
  }

  .payoff-drivers b {
    font-weight: 600;
    color: var(--cream);
  }

  .payoff-go {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e0c4a0;
    font-weight: 500;
  }

  .box-hero-visual.payoff:hover .payoff-go {
    color: #f0d8b8;
  }

  .box-explain {
    padding: 0 var(--page-pad);
    background: var(--field);
    color: var(--cream);
  }

  .box-beats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 0;
  }

  .box-beats li {
    padding: 1.75rem 1.35rem;
    border-right: 1px solid rgba(250, 248, 243, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .box-beats li:last-child { border-right: none; }

  .box-beat-n {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.35rem;
  }

  .box-beats strong {
    font-family: var(--sans);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .box-beats span:last-child {
    font-size: 0.88rem;
    color: rgba(250, 248, 243, 0.78);
    line-height: 1.45;
  }

  .section-headline.sell {
    font-family: var(--sans);
    font-weight: 600;
    font-style: normal;
    max-width: 22ch;
    letter-spacing: -0.025em;
  }

  .when-list {
    list-style: none;
    margin-top: 2.25rem;
    border-top: 1px solid var(--warm-light);
    max-width: 52rem;
  }

  .when-list li {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 1.25rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--warm-light);
    align-items: baseline;
  }

  .when-list strong {
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .when-list span {
    font-size: 0.98rem;
    color: var(--ink-light);
    line-height: 1.5;
  }

  .box-contrast {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin-top: 2.5rem;
    background: var(--warm-light);
    border: 1px solid var(--warm-light);
  }

  .box-contrast-col {
    background: var(--cream);
    padding: 1.75rem 1.65rem;
  }
  .box-contrast-col.is-this { background: var(--cream-mid); }

  .box-contrast-label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }

  .box-contrast-body {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 1.15rem;
    max-width: 28ch;
  }

  .box-contrast-col a {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
    text-decoration: none;
    font-weight: 500;
  }
  .box-contrast-col a:hover { color: var(--field); }

  .box-contrast-now {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-lighter);
  }

  .box-report-frame { margin-top: 2.25rem; }

  .box-report-frame .chrome {
    border: 1px solid var(--warm-light);
    border-radius: 12px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 18px 48px rgba(24, 21, 15, 0.08);
  }

  .box-report-frame .chrome-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    background: var(--cream-mid);
    border-bottom: 1px solid var(--warm-light);
  }

  .box-report-frame .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warm-light);
  }

  .box-report-frame .url {
    margin-left: 0.75rem;
    font-size: 0.7rem;
    color: var(--ink-lighter);
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .box-report-frame .portal-frame {
    display: block;
    width: 100%;
    height: min(72vh, 720px);
    border: 0;
    background: var(--cream);
  }

  .box-report-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-lighter);
    line-height: 1.55;
    max-width: 52ch;
  }

  .box-report-note a {
    color: var(--sage);
    text-decoration: none;
    font-weight: 500;
    margin-left: 0.35rem;
  }
  .box-report-note a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .box-hero {
      grid-template-columns: 1fr;
      padding-top: 6.5rem;
    }
    .box-hero-visual.payoff {
      max-width: 28rem;
    }
  }

  @media (max-width: 640px) {
    .box-beats { grid-template-columns: 1fr; }
    .box-beats li {
      border-right: none;
      border-bottom: 1px solid rgba(250, 248, 243, 0.1);
    }
    .box-beats li:last-child { border-bottom: none; }
    .when-list li { grid-template-columns: 1fr; gap: 0.35rem; }
    .box-contrast { grid-template-columns: 1fr; }
    .payoff-metrics { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .box-hero-visual.payoff,
    .box-hero-visual.payoff:hover {
      transition: none;
      transform: none;
    }
  }
</style>
